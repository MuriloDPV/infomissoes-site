---
// Card: bloco de conteúdo agrupado. Cantos bem arredondados, sem borda e sem sombra.
// 'claro' usa o fundo de cartão da superfície em volta (faixa clara; branco em cima da faixa).
// 'marinho' é o cartão escuro.
interface Props {
  as?: 'article' | 'div' | 'li' | 'ul';
  variante?: 'claro' | 'marinho';
  class?: string;
  [atributo: `data-${string}`]: string | boolean | undefined;
}

const { as: Tag = 'div', variante = 'claro', class: classe, ...resto } = Astro.props;
---

<Tag class:list={['card', `card--${variante}`, { 'sup-marinho': variante === 'marinho' }, classe]} {...resto}>
  <slot />
</Tag>

<style>
  /* Estilos do componente ficam na camada components: utilitários do Tailwind vencem. */
  @layer components {
    .card {
      position: relative;
      display: flex;
      flex-direction: column;
      border-radius: var(--radius-2xl);
    }

    .card--claro {
      --sup-linha: var(--sup-cartao-linha);
      background-color: var(--sup-cartao);
    }
  }
</style>
