---
// Mapa das cidades atendidas: cada sede como um ponto de luz, na posição real (IBGE, src/data/sedes-ibge.ts),
// ligadas por linhas de fibra. As linhas ligam cada cidade à mais próxima (árvore de menor distância):
// são ilustrativas, não o traçado da rede, e o mapa diz isso embaixo. Um pulso de luz passa por algumas.
// Só SVG + CSS; o movimento só existe com JS (html.js), sem movimento reduzido, e para fora da tela.
// Falta posição de alguma cidade: o mapa não aparece (o build avisa).
import { site } from '../../data/site.ts';
import { sedesIbge } from '../../data/sedes-ibge.ts';

interface Props {
  class?: string;
}

const { class: classe } = Astro.props;

const faltando = site.cidades.filter((c) => !sedesIbge[c]);
if (faltando.length) console.warn(`[mapa] sem posição do IBGE para: ${faltando.join(', ')} (o mapa não aparece)`);
const mostrar = site.cidades.length > 1 && faltando.length === 0;

// Projeção simples (equiretangular com correção da latitude): boa o bastante para uma região pequena.
const sedes = site.cidades.map((nome) => ({ nome, ...sedesIbge[nome] }));
const lat0 = sedes.reduce((s, c) => s + c.lat, 0) / (sedes.length || 1);
const kx = Math.cos((lat0 * Math.PI) / 180);
const minX = Math.min(...sedes.map((c) => c.lon * kx));
const maxX = Math.max(...sedes.map((c) => c.lon * kx));
const maxY = Math.max(...sedes.map((c) => c.lat));
const minY = Math.min(...sedes.map((c) => c.lat));
const L = 300; // largura útil
const escala = L / (maxX - minX || 1);
const M = { x: 50, topo: 36, pe: 36 };
const W = L + M.x * 2;
const H = (maxY - minY) * escala + M.topo + M.pe;
const pontos = sedes.map((c) => ({
  nome: c.nome,
  x: M.x + (c.lon * kx - minX) * escala,
  y: M.topo + (maxY - c.lat) * escala,
}));

// Árvore de menor distância (Prim): cada cidade ligada à mais próxima já ligada.
const ligadas = new Set([0]);
const linhas: [number, number][] = [];
while (mostrar && ligadas.size < pontos.length) {
  let melhor: [number, number] | null = null;
  let menor = Infinity;
  for (const a of ligadas)
    pontos.forEach((p, b) => {
      if (ligadas.has(b)) return;
      const d = Math.hypot(p.x - pontos[a].x, p.y - pontos[a].y);
      if (d < menor) [menor, melhor] = [d, [a, b]];
    });
  if (!melhor) break;
  ligadas.add(melhor[1]);
  linhas.push(melhor);
}

// Linha levemente curva (como um cabo), da cidade a para a b.
const curva = ([a, b]: [number, number]) => {
  const p = pontos[a];
  const q = pontos[b];
  const mx = (p.x + q.x) / 2 - (q.y - p.y) * 0.12;
  const my = (p.y + q.y) / 2 + (q.x - p.x) * 0.12;
  const n = (v: number) => Math.round(v * 10) / 10;
  return `M${n(p.x)} ${n(p.y)}Q${n(mx)} ${n(my)} ${n(q.x)} ${n(q.y)}`;
};

// Posição de cada nome: à direita do ponto, senão à esquerda, embaixo ou em cima — o primeiro lado que
// cabe no mapa sem bater em outro nome ou ponto. As medidas são do mapa no celular (o nome ocupa mais).
type Lado = 'direita' | 'esquerda' | 'embaixo' | 'em-cima';
const pxPorUnidade = 300 / W; // mapa com ~300px de largura no celular
const u = (px: number) => px / pxPorUnidade;
type Caixa = { x0: number; x1: number; y0: number; y1: number };
const bate = (a: Caixa, b: Caixa) => a.x0 < b.x1 && b.x0 < a.x1 && a.y0 < b.y1 && b.y0 < a.y1;
const caixasPontos: Caixa[] = pontos.map((p) => ({ x0: p.x - 6, x1: p.x + 6, y0: p.y - 6, y1: p.y + 6 }));
const ocupadas: Caixa[] = [];
const lados = new Map<string, Lado>();
for (const p of [...pontos].sort((a, b) => a.y - b.y)) {
  const w = u(p.nome.length * 7.4);
  const h = u(17);
  const folga = u(14);
  const opcoes: [Lado, Caixa][] = [
    ['direita', { x0: p.x + folga, x1: p.x + folga + w, y0: p.y - h / 2, y1: p.y + h / 2 }],
    ['esquerda', { x0: p.x - folga - w, x1: p.x - folga, y0: p.y - h / 2, y1: p.y + h / 2 }],
    ['embaixo', { x0: p.x - w / 2, x1: p.x + w / 2, y0: p.y + folga * 0.7, y1: p.y + folga * 0.7 + h }],
    ['em-cima', { x0: p.x - w / 2, x1: p.x + w / 2, y0: p.y - folga * 0.7 - h, y1: p.y - folga * 0.7 }],
  ];
  const cabe = ([, c]: [Lado, Caixa]) =>
    c.x0 >= -M.x * 0.4 && c.x1 <= W + M.x * 0.4 && ![...ocupadas, ...caixasPontos].some((o) => bate(c, o));
  const [lado, caixa] = opcoes.find(cabe) ?? opcoes[0];
  ocupadas.push(caixa);
  lados.set(p.nome, lado);
}
const pct = (v: number, total: number) => `${((v / total) * 100).toFixed(2)}%`;
---

{
  mostrar && (
    <figure class:list={['mapa sup-noite', classe]} data-pausavel>
      <div class="mapa__area" style={`aspect-ratio: ${W} / ${Math.round(H)}`}>
        <svg class="mapa__svg" viewBox={`0 0 ${W} ${Math.round(H)}`} aria-hidden="true" focusable="false">
          <g class="mapa__linhas">
            {linhas.map((l) => (
              <path d={curva(l)} />
            ))}
          </g>
          <g>
            {linhas.slice(0, 4).map((l, i) => (
              <path class="mapa__luz" d={curva(l)} pathLength="100" style={`--atraso:${i * 1.6}s;--parada:-${30 + i * 12}`} />
            ))}
          </g>
          <g class="mapa__pontos">
            {pontos.map((p) => (
              <g>
                <circle class="mapa__halo" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="11" />
                <circle class="mapa__ponto" cx={p.x.toFixed(1)} cy={p.y.toFixed(1)} r="4" />
              </g>
            ))}
          </g>
        </svg>
        <ul class="mapa__nomes" aria-hidden="true">
          {pontos.map((p) => (
            <li class:list={['mapa__nome', `mapa__nome--${lados.get(p.nome)}`]} style={`left:${pct(p.x, W)};top:${pct(p.y, H)}`}>
              {p.nome}
            </li>
          ))}
        </ul>
      </div>
      <figcaption class="mapa__legenda">Posição das sedes: IBGE. As linhas são ilustrativas.</figcaption>
    </figure>
  )
}

<style>
  @layer components {
    .mapa {
      display: flex;
      flex-direction: column;
      gap: 1rem;
      padding: 1.5rem 1.25rem 1.25rem;
      border-radius: var(--radius-2xl);
    }
    @media (width >= 48rem) {
      .mapa {
        padding: 2rem 2rem 1.5rem;
      }
    }

    .mapa__area {
      position: relative;
      width: 100%;
      max-width: 22rem;
      margin-inline: auto;
    }

    .mapa__svg {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
      overflow: visible;
    }

    .mapa path {
      fill: none;
      stroke-linecap: round;
    }
    .mapa__linhas path {
      stroke: rgb(163 171 197 / 0.32);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }
    .mapa__luz {
      stroke: var(--color-azul);
      stroke-width: 2.5;
      stroke-dasharray: 14 200;
      stroke-dashoffset: var(--parada, -40);
    }

    .mapa__halo {
      fill: rgb(1 153 218 / 0.18);
      stroke: rgb(1 153 218 / 0.55);
      stroke-width: 1;
      vector-effect: non-scaling-stroke;
    }
    .mapa__ponto {
      fill: var(--color-branco);
    }

    .mapa__nomes {
      position: absolute;
      inset: 0;
    }
    .mapa__nome {
      position: absolute;
      color: var(--color-marinho-200);
      font-size: 0.875rem;
      font-weight: var(--font-weight-semibold);
      line-height: 1.2;
      white-space: nowrap;
      transform: translate(0.875rem, -50%);
    }
    .mapa__nome--esquerda {
      transform: translate(calc(-100% - 0.875rem), -50%);
    }
    .mapa__nome--embaixo {
      transform: translate(-50%, 0.625rem);
    }
    .mapa__nome--em-cima {
      transform: translate(-50%, calc(-100% - 0.625rem));
    }

    .mapa__legenda {
      color: var(--color-marinho-300);
      font-size: var(--text-rotulo);
      line-height: var(--text-rotulo--line-height);
    }

    @media (prefers-reduced-motion: no-preference) {
      :global(html.js) .mapa__luz {
        animation: mapa-luz 7s linear var(--atraso, 0s) infinite both;
      }
      .mapa:global(.is-pausado) .mapa__luz {
        animation-play-state: paused;
      }
    }
    @keyframes mapa-luz {
      0% {
        stroke-dashoffset: 14;
        animation-timing-function: cubic-bezier(0.45, 0, 0.3, 1);
      }
      40%,
      100% {
        stroke-dashoffset: -100;
      }
    }
  }
</style>
