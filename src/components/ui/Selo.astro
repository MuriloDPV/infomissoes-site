---
// Selo/Badge: rótulo curto. Amarelo sempre com texto marinho.
import Icone, { type IconeNome } from './Icone.astro';

interface Props {
  variante?: 'amarelo' | 'marinho' | 'suave';
  icone?: IconeNome;
  class?: string;
}

const { variante = 'amarelo', icone, class: classe } = Astro.props;
---

<span class:list={['selo', `selo--${variante}`, classe]}>
  {icone && <Icone nome={icone} class="selo__icone" />}
  <slot />
</span>

<style>
  /* Estilos do componente ficam na camada components: utilitários do Tailwind vencem. */
  @layer components {
    .selo {
      display: inline-flex;
      align-items: center;
      gap: 0.375rem;
      width: fit-content;
      padding: 0.3125rem 0.75rem;
      border-radius: var(--radius-full);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-bold);
      line-height: 1.25;
      white-space: nowrap;
    }

    .selo__icone {
      width: 1rem;
      height: 1rem;
    }

    .selo--amarelo {
      background-color: var(--color-amarelo);
      color: var(--color-marinho);
    }

    .selo--marinho {
      background-color: var(--color-marinho);
      color: var(--color-branco);
    }

    .selo--suave {
      background-color: var(--color-fundo);
      color: var(--color-marinho);
      box-shadow: inset 0 0 0 1px var(--color-marinho-100);
    }
  }
</style>
