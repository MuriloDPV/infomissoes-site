---
// Botão (link com cara de botão). As cores se ajustam sozinhas à superfície (.sup-*).
// primario: marinho sólido (branco em fundo escuro) · secundario: contorno · link: texto com seta.
// Sóbrio: no hover só a cor muda (0,2 s) e a seta desliza. Altura mínima de 52px (60px no lg).
import Icone, { type IconeNome } from './Icone.astro';

interface Props {
  href: string;
  variante?: 'primario' | 'secundario' | 'link';
  tamanho?: 'md' | 'lg';
  /** Ícone antes do texto. */
  icone?: IconeNome;
  /** Seta depois do texto (links internos). */
  seta?: boolean;
  /** Abre em nova aba com rel="noopener" e avisa leitores de tela. */
  externo?: boolean;
  /** Mostra a setinha de "nova aba" (padrão: sim, quando externo). */
  indicador?: boolean;
  cheio?: boolean;
  class?: string;
  [atributo: `data-${string}`]: string | boolean | undefined;
  'aria-label'?: string;
}

const {
  href,
  variante = 'primario',
  tamanho = 'md',
  icone,
  seta = false,
  externo = false,
  indicador = true,
  cheio = false,
  class: classe,
  ...resto
} = Astro.props;
---

<a
  href={href}
  class:list={['botao', `botao--${variante}`, `botao--${tamanho}`, { 'botao--cheio': cheio }, classe]}
  target={externo ? '_blank' : undefined}
  rel={externo ? 'noopener' : undefined}
  {...resto}
>
  {icone && <Icone nome={icone} class="botao__icone" />}
  <span class="botao__rotulo"><slot /></span>
  {externo && indicador && <Icone nome="externo" class="botao__seta botao__seta--externo" />}
  {!externo && seta && <Icone nome="seta" class="botao__seta" />}
  {externo && <span class="sr-only"> (abre em nova aba)</span>}
</a>

<style>
  /* Estilos do componente ficam na camada components: utilitários do Tailwind vencem. */
  @layer components {
    .botao {
      position: relative;
      isolation: isolate;
      display: inline-flex;
      align-items: center;
      justify-content: center;
      gap: 0.625rem;
      min-height: var(--spacing-toque);
      padding: 0.75rem 1.375rem;
      border-radius: var(--radius-md);
      font-size: var(--text-base);
      font-weight: var(--font-weight-bold);
      line-height: 1.2;
      letter-spacing: var(--tracking-rotulo);
      text-align: center;
      text-decoration: none;
      touch-action: manipulation;
      user-select: none;
    }

    .botao--lg {
      min-height: var(--spacing-toque-lg);
      padding-inline: 1.5rem;
    }

    /* No celular estreito o rótulo do botão grande fica em 18px, para caber numa linha */
    @media (width >= 30rem) {
      .botao--lg {
        padding-inline: 1.625rem;
        font-size: var(--text-lg);
      }
    }

    .botao--cheio {
      width: 100%;
    }

    /* Cor do hover numa camada por baixo do texto: só a opacidade anima (0,2 s) */
    .botao::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duracao-cor) var(--ease-suave);
    }

    .botao__icone {
      width: 1.375rem;
      height: 1.375rem;
      flex: none;
    }

    .botao__seta {
      width: 1.25rem;
      height: 1.25rem;
      flex: none;
      margin-right: -0.125rem;
      transition: transform var(--duracao-base) var(--ease-saida);
    }

    @media (hover: hover) {
      .botao:hover::before {
        opacity: 1;
      }
      .botao:hover .botao__seta {
        transform: translate3d(4px, 0, 0);
      }
      .botao:hover .botao__seta--externo {
        transform: translate3d(3px, -3px, 0);
      }
    }

    .botao:active::before {
      opacity: 1;
    }

    /* Primário: marinho sólido (em fundo escuro, branco com texto marinho) */
    .botao--primario {
      background-color: var(--sup-b1-fundo);
      color: var(--sup-b1-texto);
    }
    .botao--primario::before {
      background-color: var(--sup-b1-realce);
    }

    /* Secundário: contorno */
    .botao--secundario {
      color: var(--sup-b2-texto);
      box-shadow: inset 0 0 0 1.5px var(--sup-b2-borda);
    }
    .botao--secundario::before {
      background-color: var(--sup-b2-realce);
    }

    /* Link com seta: sem caixa, sublinhado discreto que acende no hover */
    .botao--link {
      min-height: 3rem;
      padding-inline: 0;
      color: var(--sup-link);
      text-decoration: underline;
      text-decoration-color: color-mix(in srgb, currentColor 30%, transparent);
      transition: text-decoration-color var(--duracao-cor) var(--ease-suave);
    }
    .botao--link::before {
      display: none;
    }
    @media (hover: hover) {
      .botao--link:hover {
        text-decoration-color: currentColor;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .botao__seta {
        transition: none;
      }
      .botao:hover .botao__seta {
        transform: none;
      }
    }
  }
</style>
