---
// Cartão de um plano (dados de site.ts), em linhas com divisória fina:
// DOWNLOAD / UPLOAD / POR MÊS, cada uma com o rótulo à esquerda e o valor à direita. Download e upload
// levam a seta para baixo e para cima, para não confundir. O preço é o número grande.
// Preço 'sob consulta': no lugar da linha POR MÊS, o texto "Preço sob consulta".
// Nome com tipo ("600 Mega Empresarial"): a velocidade fica grande e o tipo, menor, embaixo.
// Botão: WhatsApp com a mensagem padrão + `mensagem` (padrão: "Tenho interesse no plano X.")
// e o texto `acao` (sem WhatsApp, "Quero este plano" leva à página de contato).
// `compacto` (resumo da Início): menor e sem botão; o link "Ver os planos" fica fora dos cartões.
import Botao from './Botao.astro';
import Card from './Card.astro';
import LinhasInfo, { type Linha } from './LinhasInfo.astro';
import Selo from './Selo.astro';
import type { Plano } from '../../data/site.ts';
import { SOB_CONSULTA } from '../../lib/contato.ts';
import { whatsappMensagem } from '../../lib/dados.ts';

interface Props {
  plano: Plano;
  compacto?: boolean;
  /** Nível do título: h2 quando o h1 da página é "Planos", h3 dentro de uma seção. */
  nivel?: 2 | 3;
  /** Frase depois da mensagem padrão do WhatsApp. */
  mensagem?: string;
  /** Texto do botão do WhatsApp. */
  acao?: string;
  class?: string;
}

const {
  plano: p,
  compacto = false,
  nivel = 3,
  mensagem = `Tenho interesse no plano ${p.nome}.`,
  acao = 'Quero este plano',
  class: classe,
} = Astro.props;
const Titulo = nivel === 2 ? 'h2' : 'h3';
const link = whatsappMensagem(mensagem);
const sobConsulta = p.preco === SOB_CONSULTA;
const [, velocidade, tipo] = /^(\S+ \S+) (.+)$/.exec(p.nome) ?? [null, p.nome, null];

const linhas: Linha[] = [{ rotulo: 'Download', valor: p.download, icone: 'download' }];
// Sem upload informado (null), a linha não aparece.
if (p.upload) linhas.push({ rotulo: 'Upload', valor: p.upload, icone: 'upload' });
if (!sobConsulta) linhas.push({ rotulo: p.periodo ?? 'Por mês', valor: p.preco, destaque: true });
---

<Card as="article" class:list={['plano w-full', { 'plano--compacto': compacto }, classe]}>
  {p.selo && <Selo class="plano__selo">{p.selo}</Selo>}
  <Titulo class="plano__nome tabular">
    {velocidade}{tipo && <>{' '}<span class="plano__tipo">{tipo}</span></>}
  </Titulo>

  <div class="plano__linhas">
    <LinhasInfo compacto={compacto} linhas={linhas} />
    {sobConsulta && <p class="plano__consulta">Preço sob consulta</p>}
  </div>

  {
    !compacto && p.beneficios && p.beneficios.length > 0 && (
      <ul class="plano__beneficios">
        {p.beneficios.map((b) => (
          <li>{b}</li>
        ))}
      </ul>
    )
  }

  {
    !compacto && (
      <div class="plano__acao">
        {link ? (
          <Botao href={link} externo indicador={false} icone="whatsapp" tamanho="lg" cheio data-cta-whatsapp>
            {acao}
          </Botao>
        ) : (
          <Botao href="/contato/" tamanho="lg" seta cheio>
            Quero este plano
          </Botao>
        )}
      </div>
    )
  }
</Card>

<style>
  @layer components {
    .plano {
      container-type: inline-size;
      gap: 1.75rem;
      padding: 1.75rem 1.5rem 1.5rem;
    }
    @media (width >= 48rem) {
      .plano {
        padding: 2.25rem 2rem 2rem;
      }
    }

    .plano :global(.plano__selo) {
      align-self: flex-start;
    }

    /* Nome e preço acompanham a largura do cartão (container), sem quebrar linha */
    .plano__nome {
      font-size: clamp(1.75rem, 15cqi, 3rem);
      white-space: nowrap;
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-destaque);
      line-height: var(--leading-justo);
    }
    /* Tipo do plano (Empresarial, Rural): embaixo da velocidade, menor */
    .plano__tipo {
      display: block;
      margin-top: 0.375rem;
      color: var(--sup-suave);
      font-size: var(--text-xl);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.01em;
      line-height: var(--leading-titulo);
    }

    .plano__linhas {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
    }
    /* Sem preço fixo: o texto ocupa o lugar do número grande */
    .plano__consulta {
      color: var(--sup-titulo);
      font-size: var(--text-xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: -0.015em;
      line-height: var(--leading-titulo);
    }

    .plano__beneficios {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
      padding-left: 1.25rem;
      list-style: disc;
    }

    .plano__acao {
      margin-top: auto;
    }
    /* Cartão estreito (3 colunas em telas de ~1024px): o botão continua com 60px, o texto um pouco menor */
    @container (width < 19rem) {
      .plano__acao :global(.botao) {
        gap: 0.5rem;
        padding-inline: 1rem;
        font-size: var(--text-base);
      }
    }

    /* Compacto (resumo da Início): mesma leitura, em tamanho menor */
    .plano--compacto {
      gap: 1.25rem;
      padding: 1.5rem 1.5rem 1.25rem;
    }
    .plano--compacto .plano__nome {
      font-size: clamp(1.5rem, 10cqi, 2.25rem);
    }
  }
</style>
