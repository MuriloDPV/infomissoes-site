---
// Cartão de um plano (dados de site.ts). Download e upload em linhas separadas, com seta e palavra,
// para não confundir. Preço em destaque, com "R$" menor. Botão: WhatsApp com a mensagem padrão
// + "Tenho interesse no plano X." (sem WhatsApp, leva à página de contato).
// `compacto` (resumo da Início): menor e sem botão; o link "Ver os planos" fica fora dos cartões.
import Botao from './Botao.astro';
import Card from './Card.astro';
import Icone from './Icone.astro';
import Selo from './Selo.astro';
import type { Plano } from '../../data/site.ts';
import { valorPreco } from '../../lib/contato.ts';
import { whatsappMensagem } from '../../lib/dados.ts';

interface Props {
  plano: Plano;
  compacto?: boolean;
  /** Nível do título: h2 quando o h1 da página é "Planos", h3 dentro de uma seção. */
  nivel?: 2 | 3;
  class?: string;
}

const { plano: p, compacto = false, nivel = 3, class: classe } = Astro.props;
const Titulo = nivel === 2 ? 'h2' : 'h3';
const valor = valorPreco(p.preco);
const link = whatsappMensagem(`Tenho interesse no plano ${p.nome}.`);
const variante = p.selo ? 'destaque' : 'primario';
---

<Card
  as="article"
  interativo={!compacto}
  class:list={['plano w-full', { 'plano--compacto': compacto, 'plano--selo': p.selo }, classe]}
>
  {p.selo && <Selo class="plano__selo">{p.selo}</Selo>}
  <Titulo class="plano__nome tabular">{p.nome}</Titulo>

  <dl class="plano__velocidades">
    <div class="plano__velocidade">
      <dt><Icone nome="download" class="plano__seta" />Download</dt>
      <dd class="tabular">{p.download}</dd>
    </div>
    <div class="plano__velocidade">
      <dt><Icone nome="upload" class="plano__seta" />Upload</dt>
      <dd class="tabular">{p.upload}</dd>
    </div>
  </dl>

  <p class="plano__preco">
    {
      valor ? (
        <>
          <span class="plano__moeda">R$</span>
          <span class="plano__valor tabular">{valor}</span>
        </>
      ) : (
        <span class="plano__valor tabular">{p.preco}</span>
      )
    }
    <span class="plano__periodo">{p.periodo ?? 'por mês'}</span>
  </p>

  {
    !compacto && p.beneficios && p.beneficios.length > 0 && (
      <ul class="flex flex-col gap-3">
        {p.beneficios.map((b) => (
          <li class="flex gap-3">
            <Icone nome="check" class="mt-1 size-5 shrink-0 text-sup-icone" />
            <span>{b}</span>
          </li>
        ))}
      </ul>
    )
  }

  {
    !compacto && (
      <div class="mt-auto">
        {link ? (
          <Botao
            href={link}
            externo
            indicador={false}
            icone="whatsapp"
            variante={variante}
            tamanho="lg"
            cheio
            data-cta-whatsapp
          >
            Quero este plano
          </Botao>
        ) : (
          <Botao href="/contato/" variante={variante} tamanho="lg" seta cheio>
            Quero este plano
          </Botao>
        )}
      </div>
    )
  }
</Card>

<style>
  @layer components {
    .plano {
      gap: 1.5rem;
      padding: 1.75rem 1.5rem 1.5rem;
    }
    @media (width >= 48rem) {
      .plano {
        padding: 2rem 2rem 1.75rem;
      }
    }

    /* Plano com selo: contorno amarelo */
    .plano--selo {
      box-shadow:
        inset 0 0 0 2px var(--color-amarelo),
        var(--shadow-md);
    }
    .plano :global(.plano__selo) {
      position: absolute;
      top: -1rem;
      left: 1.5rem;
      box-shadow: var(--shadow-sm);
    }

    .plano__nome {
      font-size: var(--text-3xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-destaque);
      line-height: var(--leading-justo);
    }

    /* Download e upload: uma linha cada, rótulo à esquerda e velocidade à direita */
    .plano__velocidades {
      display: flex;
      flex-direction: column;
      border-block: 1px solid var(--sup-linha);
    }
    .plano__velocidade {
      display: flex;
      align-items: center;
      justify-content: space-between;
      gap: 1rem;
      min-height: 3.5rem;
      padding-block: 0.5rem;
    }
    .plano__velocidade + .plano__velocidade {
      border-top: 1px solid var(--sup-linha);
    }
    .plano__velocidade dt {
      display: inline-flex;
      align-items: center;
      gap: 0.625rem;
      color: var(--sup-texto);
      font-weight: var(--font-weight-semibold);
    }
    .plano__velocidade dd {
      color: var(--sup-titulo);
      font-size: var(--text-xl);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.015em;
      white-space: nowrap;
    }
    .plano__seta {
      width: 1.375rem;
      height: 1.375rem;
      flex: none;
      color: var(--sup-icone);
    }

    /* Preço em destaque: bloco de fundo claro dentro do cartão */
    .plano__preco {
      display: flex;
      flex-wrap: wrap;
      align-items: baseline;
      column-gap: 0.375rem;
      padding: 1rem 1.25rem;
      border-radius: var(--radius-lg);
      background-color: var(--color-fundo);
      color: var(--sup-titulo);
    }
    .plano__moeda {
      font-size: var(--text-xl);
      font-weight: var(--font-weight-bold);
    }
    .plano__valor {
      font-size: var(--text-3xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-destaque);
      line-height: var(--leading-justo);
    }
    /* "por mês" sempre na linha de baixo, igual em todos os cartões */
    .plano__periodo {
      flex-basis: 100%;
      color: var(--sup-suave);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-semibold);
    }

    /* Compacto (resumo da Início): mesma leitura, em tamanho menor */
    .plano--compacto {
      gap: 1.25rem;
      padding: 1.5rem;
    }
    .plano--compacto .plano__nome {
      font-size: var(--text-2xl);
    }
    .plano--compacto .plano__velocidade {
      min-height: 3rem;
    }
    .plano--compacto .plano__velocidade dd {
      font-size: var(--text-lg);
    }
    .plano--compacto .plano__preco {
      padding: 0.875rem 1.125rem;
    }
    .plano--compacto .plano__moeda {
      font-size: var(--text-lg);
    }
    .plano--compacto .plano__valor {
      font-size: var(--text-2xl);
    }
  }
</style>
