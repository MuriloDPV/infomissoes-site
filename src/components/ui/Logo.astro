---
// Logo da Info Missões. SVG em camadas vai direto no HTML (as camadas viram data-camada);
// outros formatos usam <Image>. Sem arquivo em site.ts, mostra o nome em texto
// (e, em dev, a marcação de pendente em volta).
// `animada` (só no cabeçalho): ondas de sinal para a entrada da logo e o pulso da antena.
import { Image } from 'astro:assets';
import { site } from '../../data/site.ts';
import { logo, logoFundoEscuro, type Marca } from '../../lib/dados.ts';

interface Props {
  tom?: 'claro' | 'escuro';
  animada?: boolean;
  class?: string;
  [atributo: string]: unknown;
}

// `resto` repassa o atributo de escopo do pai (data-astro-cid-*), para os estilos do pai valerem aqui.
const { tom = 'claro', animada = false, class: classe, ...resto } = Astro.props;
const DEV = import.meta.env.DEV;
const marca: Marca | null = tom === 'escuro' ? logoFundoEscuro : logo;

// Centro da antena e raio das ondas, nas coordenadas da logo (2000 × 1128).
const ANTENA = { x: 707.5, y: 543 };
const ondas = animada
  ? `<defs><clipPath id="logo-onda"><circle cx="${ANTENA.x}" cy="${ANTENA.y}" r="1350"/></clipPath></defs>` +
    `<g class="logo__ondas" fill="none" stroke="#0199da" stroke-width="2">` +
    [1, 2, 3]
      .map((n) => `<circle class="logo__onda logo__onda--${n}" cx="${ANTENA.x}" cy="${ANTENA.y}" r="150" vector-effect="non-scaling-stroke"/>`)
      .join('') +
    `</g>`
  : '';

function prepararSvg(svg: string): string {
  return svg
    .replace(/<\?xml[^>]*>/, '')
    .trim()
    .replace(/ id="(ruins|tower|antena|arcs|info|missoes|prov)"/g, (_, camada) =>
      animada && camada === 'ruins' ? ` data-camada="ruins" clip-path="url(#logo-onda)"` : ` data-camada="${camada}"`
    )
    .replace(
      /<svg([^>]*)>/,
      (_, atributos) =>
        `<svg${atributos} class="logo__svg" role="img" aria-label="${site.nome}" focusable="false" preserveAspectRatio="xMinYMid meet">${ondas}`
    );
}
---

{
  marca && 'svg' in marca ? (
    <span {...resto} class:list={['logo', `logo--${tom}`, { 'logo--animada': animada }, classe]} set:html={prepararSvg(marca.svg)} />
  ) : marca ? (
    <Image {...resto} src={marca.imagem} alt={site.nome} height={56} class:list={['logo__imagem', classe]} loading="eager" />
  ) : (
    <span {...resto} class:list={['logo logo--texto', `logo--${tom}`, { 'logo--pendente': DEV }, classe]}>
      <span class="logo__nome">{site.nome}</span>
      {DEV && <span class="logo__aviso">TODO: {tom === 'escuro' ? 'logo para fundo escuro' : 'logo'}</span>}
    </span>
  )
}

<style>
  /* Estilos do componente ficam na camada components: utilitários do Tailwind vencem. */
  @layer components {
    .logo {
      display: inline-flex;
      align-items: center;
      height: var(--logo-altura, 3rem);
    }

    .logo :global(.logo__svg) {
      display: block;
      height: 100%;
      width: auto;
      overflow: visible;
    }

    .logo__imagem {
      height: var(--logo-altura, 3rem);
      width: auto;
    }

    /* Ondas: invisíveis fora da animação de entrada e do pulso */
    .logo :global(.logo__onda) {
      opacity: 0;
      transform-box: fill-box;
      transform-origin: center;
    }

    /* Pulso leve de sinal na antena, de tempos em tempos (depois da entrada).
       Para quando a logo sai da tela ou com movimento reduzido. */
    @media (prefers-reduced-motion: no-preference) {
      :global(html:not(.intro)) .logo--animada :global(.logo__onda--1) {
        animation: logo-pulso 5.2s var(--ease-saida) 1.6s infinite;
      }
      .logo--animada.is-pausado :global(.logo__onda--1) {
        animation-play-state: paused;
      }
    }

    @keyframes logo-pulso {
      0% {
        opacity: 0;
        transform: scale(0.5);
      }
      6% {
        opacity: 0.75;
      }
      32%,
      100% {
        opacity: 0;
        transform: scale(1.3);
      }
    }

    /* Sem arquivo: nome em texto */
    .logo--texto {
      position: relative;
      height: auto;
      font-size: var(--text-xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
      line-height: 1;
      white-space: nowrap;
      color: var(--color-marinho);
    }

    .logo--texto.logo--escuro {
      color: var(--color-branco);
    }

    .logo--pendente {
      padding: 0.375rem 0.625rem;
      border: 2px dashed currentColor;
      border-radius: var(--radius-sm);
    }

    .logo__aviso {
      position: absolute;
      top: -0.75rem;
      left: 0.375rem;
      padding: 0 0.25rem;
      background: var(--color-amarelo);
      color: var(--color-marinho);
      font-size: 0.6875rem;
      letter-spacing: 0;
      line-height: 1.4;
    }
  }
</style>
