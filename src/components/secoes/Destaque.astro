---
// Destaque (hero) da Início. Fundo claro e calmo, título grande e, ao fundo, a versão clara da arte:
// o traço das ruínas e as linhas de fibra em marinho bem suave, com o pulso de luz passando de vez em
// quando (pausa fora da tela). A arte fica à direita no desktop e no pé no celular, longe do texto.
// Com foto própria em site.ts (fotos.destaque), a foto entra à direita.
import ArteRuinas from '../ui/ArteRuinas.astro';
import Botao from '../ui/Botao.astro';
import Foto from '../ui/Foto.astro';
import Pendente from '../ui/Pendente.astro';
import { site } from '../../data/site.ts';
import { DEV, imagemFoto, portal, whatsapp } from '../../lib/dados.ts';

const temFoto = !!imagemFoto(site.fotos.destaque, 'fotos.destaque');
---

<section
  id="inicio"
  data-destaque
  class:list={['destaque sup-suave', temFoto ? 'destaque--com-foto' : 'destaque--sem-foto']}
  aria-labelledby="destaque-titulo"
>
  <ArteRuinas tom="claro" class="destaque__arte" />

  <div
    class="relative mx-auto grid w-full max-w-pagina gap-12 px-calha pt-14 md:pt-24 lg:grid-cols-12 lg:items-center lg:pt-28"
  >
    <div class="flex flex-col gap-6 md:gap-7 lg:col-span-7">
      <h1 id="destaque-titulo" class="text-destaque tracking-destaque">
        Internet de fibra óptica nas <span class="marca-texto">Missões</span>
      </h1>
      <p class="max-w-texto text-lg text-sup-suave md:text-xl">
        A Info Missões leva internet por fibra óptica até a sua casa, com atendimento aqui mesmo, na região.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap md:pt-4">
        {
          whatsapp ? (
            <Botao href={whatsapp} externo indicador={false} icone="whatsapp" tamanho="lg" data-cta-whatsapp>
              Chamar no WhatsApp
            </Botao>
          ) : DEV ? (
            <Pendente texto="botão do WhatsApp" campo="whatsapp" forma="linha" />
          ) : (
            <Botao href="/planos/" tamanho="lg" seta>
              Ver planos
            </Botao>
          )
        }
        <Botao href={portal.url} externo variante="secundario" icone="usuario" tamanho="lg">
          {portal.nome}
        </Botao>
      </div>
    </div>

    {
      temFoto && (
        <div class="lg:col-span-5">
          <Foto
            foto={site.fotos.destaque}
            campo="fotos.destaque"
            descricao="foto do destaque"
            proporcao="retrato"
            sizes="(min-width: 76rem) 30rem, (min-width: 64rem) 40vw, 100vw"
            prioridade
            paisagemNoCelular
            class="mx-auto max-w-md lg:max-w-none"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  @layer components {
    .destaque {
      position: relative;
      isolation: isolate;
      overflow: hidden;
      /* Espaço no pé para a arte aparecer inteira embaixo dos botões no celular
         (altura da arte: 52% da largura dela) */
      padding-bottom: calc(118vw * 0.52 + 0.5rem);
    }

    /* Celular e tablet: a arte fica no pé, um pouco mais larga que a tela */
    .destaque :global(.destaque__arte) {
      --arte-largura: 118%;
      --arte-pe: -0.75rem;
    }

    @media (width >= 48rem) {
      .destaque {
        padding-bottom: 26rem;
      }
      .destaque :global(.destaque__arte) {
        --arte-largura: 50rem;
        --arte-x: -42%;
      }
    }

    /* Desktop: a arte vai para a direita, ao lado do texto */
    @media (width >= 64rem) {
      .destaque {
        padding-bottom: 8rem;
      }
      .destaque :global(.destaque__arte) {
        --arte-largura: min(54vw, 52rem);
        --arte-x: -4%;
        --arte-pe: 1.5rem;
      }
    }
  }
</style>
