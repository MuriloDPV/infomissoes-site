---
// Destaque (hero). Fundo claro e calmo; ao fundo, ondas de sinal saindo de um ponto,
// como na antena da logo. De vez em quando uma onda passa (pausa fora da tela).
import Botao from '../ui/Botao.astro';
import Foto from '../ui/Foto.astro';
import Ondas from '../ui/Ondas.astro';
import Pendente from '../ui/Pendente.astro';
import { site } from '../../data/site.ts';
import { DEV, imagemFoto, portal, whatsapp } from '../../lib/dados.ts';

const temFoto = !!imagemFoto(site.fotos.destaque, 'fotos.destaque');
const mostrarFoto = temFoto || DEV;

---

<section
  id="inicio"
  data-destaque
  class:list={['destaque sup-suave', mostrarFoto ? 'destaque--com-foto' : 'destaque--sem-foto']}
  aria-labelledby="destaque-titulo"
>
  <Ondas pulso class="destaque__ondas" />

  <div
    class:list={[
      'relative mx-auto grid w-full max-w-pagina gap-12 px-calha pt-14 pb-20 md:pt-24 md:pb-28 lg:grid-cols-12 lg:items-center lg:pt-28 lg:pb-36',
    ]}
  >
    <div class:list={['flex flex-col gap-6 md:gap-7', mostrarFoto ? 'lg:col-span-7' : 'lg:col-span-8']}>
      <h1 id="destaque-titulo" class="text-destaque tracking-destaque">
        Internet de fibra óptica nas <span class="marca-texto">Missões</span>
      </h1>
      <p class="max-w-texto text-lg text-sup-suave md:text-xl">
        A Info Missões leva internet por fibra óptica até a sua casa, com atendimento aqui mesmo, na região.
      </p>
      <div class="flex flex-col gap-3 pt-2 sm:flex-row sm:flex-wrap md:pt-4">
        {
          whatsapp ? (
            <Botao href={whatsapp} externo indicador={false} icone="whatsapp" tamanho="lg" data-cta-whatsapp>
              Chamar no WhatsApp
            </Botao>
          ) : DEV ? (
            <Pendente texto="botão do WhatsApp" campo="whatsapp" forma="linha" />
          ) : (
            <Botao href="/planos/" tamanho="lg" seta>
              Ver planos
            </Botao>
          )
        }
        <Botao href={portal.url} externo variante="secundario" icone="usuario" tamanho="lg">
          {portal.nome}
        </Botao>
      </div>
    </div>

    {
      mostrarFoto && (
        <div class="lg:col-span-5">
          <Foto
            foto={site.fotos.destaque}
            campo="fotos.destaque"
            descricao="foto do destaque"
            proporcao="retrato"
            sizes="(min-width: 76rem) 30rem, (min-width: 64rem) 40vw, 100vw"
            prioridade
            paisagemNoCelular
            class="mx-auto max-w-md lg:max-w-none"
          />
        </div>
      )
    }
  </div>
</section>

<style>
  @layer components {
    .destaque {
      position: relative;
      isolation: isolate;
      overflow: hidden;
    }

    /* Centro das ondas muda conforme a tela e a presença da foto */
    /* Celular: centro fora da tela, só os arcos aparecem no canto */
    .destaque__ondas {
      --sx: 112%;
      --sy: 104%;
      --tamanho: 1000px;
    }

    @media (width >= 48rem) {
      .destaque__ondas {
        --sx: 96%;
        --sy: 100%;
        --tamanho: 1200px;
      }
    }

    @media (width >= 64rem) {
      .destaque--sem-foto .destaque__ondas {
        --sx: 82%;
        --sy: 52%;
        --tamanho: 1400px;
      }
      /* Com foto: o centro fica atrás da foto e as ondas aparecem em volta dela */
      .destaque--com-foto .destaque__ondas {
        --sx: 86%;
        --sy: 70%;
        --tamanho: 1400px;
      }
    }
  }
</style>
