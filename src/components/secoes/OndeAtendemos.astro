---
// Onde atendemos (/onde-atendemos/): cidades de site.ts, cada uma com o marcador de sinal, e o convite.
// O h1 e o texto ficam na abertura da página. Sem cidades, só o convite.
import Icone from '../ui/Icone.astro';
import Pendente from '../ui/Pendente.astro';
import Secao from '../ui/Secao.astro';
import Convite from './OndeAtendemosConvite.astro';
import { site } from '../../data/site.ts';
import { DEV } from '../../lib/dados.ts';

const cidades = site.cidades;
const temCidades = cidades.length > 0;
---

<Secao id="onde-atendemos" tom="suave" class="secao--apos-abertura">
  <div class="grid gap-10 md:gap-12">
    {
      temCidades ? (
        <ul class="cidades" aria-label="Cidades atendidas">
          {cidades.map((c, i) => (
            <li class="cidade" data-revelar style={`--i:${i + 1}`}>
              <Icone nome="sinal" class="cidade__marcador" />
              <span>{c}</span>
            </li>
          ))}
        </ul>
      ) : (
        DEV && <Pendente texto="cidades atendidas" campo="cidades" class="min-h-64" />
      )
    }

    <div data-revelar>
      <Convite />
    </div>
  </div>
</Secao>

<style>
  @layer components {
    .cidades {
      display: grid;
      gap: 0.625rem;
      align-content: start;
    }

    @media (width >= 30rem) {
      .cidades {
        grid-template-columns: repeat(2, minmax(0, 1fr));
        gap: 0.75rem;
      }
    }

    @media (width >= 64rem) {
      .cidades {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        gap: 1rem;
      }
    }

    /* Cada cidade: um bloco branco grande, fácil de achar e de ler */
    .cidade {
      display: flex;
      align-items: center;
      gap: 0.875rem;
      min-height: 4rem;
      padding: 0.75rem 1.25rem 0.75rem 1rem;
      border-radius: var(--radius-lg);
      background-color: var(--color-branco);
      box-shadow:
        inset 0 0 0 1px var(--color-marinho-100),
        var(--shadow-sm);
      color: var(--color-marinho);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.01em;
      line-height: var(--leading-titulo);
    }

    .cidade__marcador {
      width: 1.625rem;
      height: 1.625rem;
      flex: none;
      color: var(--color-azul);
    }
  }
</style>
