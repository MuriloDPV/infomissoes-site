---
// Diferenciais: poucos, curtos e verdadeiros (textos em site.ts).
// O que depende do endereço da loja só aparece com o endereço preenchido (em dev, aparece com TODO).
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Icone from '../ui/Icone.astro';
import Pendente from '../ui/Pendente.astro';
import Secao from '../ui/Secao.astro';
import { site } from '../../data/site.ts';
import { DEV } from '../../lib/dados.ts';

const diferenciais = site.diferenciais.filter((d) => !d.soComEndereco || site.endereco || DEV);
const colunas = diferenciais.length >= 3 ? 'md:grid-cols-3' : 'md:grid-cols-2';
---

<Secao id="diferenciais" tom="clara">
  <div class="grid gap-12 md:gap-16">
    <CabecalhoSecao titulo="Por que escolher a Info Missões" />

    <ul class:list={['grid gap-x-10 gap-y-2 md:gap-y-10', colunas]}>
      {
        diferenciais.map((d, i) => (
          <li class="diferencial" data-revelar style={`--i:${i + 1}`}>
            <Icone nome={d.icone} class="diferencial__icone" />
            <div class="flex flex-col gap-3">
              <h3 class="text-2xl">{d.titulo}</h3>
              <p class="max-w-texto text-sup-suave">{d.texto}</p>
              {d.soComEndereco && !site.endereco && (
                <Pendente texto="endereço da loja (sem ele, este item some)" campo="endereco" forma="linha" />
              )}
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Secao>

<style>
  @layer components {
    /* Linha fina em cima, com um trecho azul no começo (como um fio de fibra) */
    .diferencial {
      position: relative;
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
      padding-block: 2rem 1.5rem;
      border-top: 1px solid var(--color-marinho-100);
    }
    .diferencial::before {
      content: '';
      position: absolute;
      top: -1px;
      left: 0;
      width: 3rem;
      height: 2px;
      border-radius: var(--radius-full);
      background-color: var(--color-azul);
    }

    @media (width >= 48rem) {
      .diferencial {
        padding-block: 2.5rem 0;
      }
    }

    .diferencial__icone {
      width: 2.25rem;
      height: 2.25rem;
      color: var(--color-azul);
    }
  }
</style>
