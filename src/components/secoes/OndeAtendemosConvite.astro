---
// Convite para perguntar se a fibra chega no endereço (usado em OndeAtendemos).
import Botao from '../ui/Botao.astro';
import { site } from '../../data/site.ts';
import { whatsapp } from '../../lib/dados.ts';

const temCidades = site.cidades.length > 0;
---

<div class="convite sup-clara">
  <div class="convite__textos">
    <p class="convite__titulo">A fibra chega na sua rua?</p>
    <p class="text-sup-suave">
      {
        temCidades
          ? 'Não encontrou a sua cidade ou quer confirmar o seu endereço? Fale com a gente.'
          : 'Fale com a gente e informe a sua rua e a sua cidade.'
      }
    </p>
  </div>
  <div class="convite__acao">
    {
      whatsapp ? (
        <Botao href={whatsapp} externo indicador={false} icone="whatsapp" class="convite__botao">
          Perguntar no WhatsApp
        </Botao>
      ) : (
        <Botao href="#contato" seta class="convite__botao">
          Falar com a gente
        </Botao>
      )
    }
  </div>
</div>

<style>
  @layer components {
    /* Celular: sem cartão, separado por uma linha, botão na largura toda */
    .convite {
      display: flex;
      flex-direction: column;
      gap: 1.25rem;
      padding-top: 2rem;
      border-top: 1px solid var(--color-marinho-200);
      background-color: transparent;
    }
    .convite :global(.convite__botao) {
      width: 100%;
    }

    .convite__textos {
      display: flex;
      flex-direction: column;
      gap: 0.5rem;
    }

    @media (width >= 40rem) {
      .convite {
        padding: 2rem;
        border-top: 0;
        border-radius: var(--radius-2xl);
        background-color: var(--color-branco);
        box-shadow: inset 0 0 0 1px var(--color-marinho-100);
      }
      .convite :global(.convite__botao) {
        width: auto;
      }
    }

    @media (width >= 56rem) {
      .convite {
        flex-direction: row;
        align-items: center;
        justify-content: space-between;
        gap: 2rem;
        padding: 2rem 2.5rem;
      }
      .convite__acao {
        flex: none;
      }
    }

    .convite__titulo {
      color: var(--color-marinho);
      font-size: var(--text-xl);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.015em;
      line-height: var(--leading-titulo);
    }
  }
</style>
