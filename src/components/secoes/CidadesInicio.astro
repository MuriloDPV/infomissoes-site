---
// Cidades atendidas na Início, logo depois do destaque: a pessoa já vê se a Info Missões atende a cidade
// dela, e logo abaixo vêm os planos e o contato. Lista curta em "chips" e o link para o mapa.
// Sem cidades, a seção não aparece.
import Botao from '../ui/Botao.astro';
import Icone from '../ui/Icone.astro';
import Secao from '../ui/Secao.astro';
import { site } from '../../data/site.ts';

const cidades = site.cidades;
---

{
  cidades.length > 0 && (
    <Secao id="cidades" tom="clara" ritmo="curta">
      <div class="cidades-inicio" data-revelar>
        <h2 class="cidades-inicio__titulo text-3xl">
          Atendemos <span class="marca-texto">{cidades.length} cidades</span>
        </h2>
        <ul class="chips" aria-label="Cidades atendidas">
          {cidades.map((c) => (
            <li class="chip">
              <Icone nome="sinal" class="chip__icone" />
              <span>{c}</span>
            </li>
          ))}
        </ul>
        <div class="flex flex-col gap-1 sm:flex-row sm:flex-wrap sm:gap-6">
          <Botao href="#planos" variante="link" seta>
            Ver os planos
          </Botao>
          <Botao href="/onde-atendemos/" variante="link" seta>
            Ver no mapa
          </Botao>
        </div>
      </div>
    </Secao>
  )
}

<style>
  @layer components {
    .cidades-inicio {
      display: flex;
      flex-direction: column;
      gap: 1.5rem;
    }

    .chips {
      display: flex;
      flex-wrap: wrap;
      gap: 0.625rem;
    }

    .chip {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 2.75rem;
      padding: 0.5rem 1rem 0.5rem 0.75rem;
      border-radius: var(--radius-full);
      background-color: var(--color-fundo);
      box-shadow: inset 0 0 0 1px var(--color-marinho-100);
      color: var(--color-marinho);
      font-weight: var(--font-weight-bold);
      line-height: 1.2;
    }

    .chip__icone {
      width: 1.125rem;
      height: 1.125rem;
      flex: none;
      color: var(--color-azul);
    }
  }
</style>
