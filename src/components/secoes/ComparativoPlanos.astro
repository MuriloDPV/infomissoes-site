---
// Comparativo dos planos para casa (/planos/): tabela limpa com uma coluna por plano e as linhas Download,
// Upload e Preço por mês, com divisória fina. Nenhuma coluna destacada (não há "mais escolhido").
// Só no desktop (a partir de 64rem): no celular e no tablet ficam só os cartões, que já têm as mesmas linhas.
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Icone, { type IconeNome } from '../ui/Icone.astro';
import Secao from '../ui/Secao.astro';
import type { Plano } from '../../data/site.ts';
import { valorPreco } from '../../lib/contato.ts';
import { planosDa } from '../../lib/planos.ts';

const planos = planosDa('casa');
const linhas: { rotulo: string; icone?: IconeNome; valor: (p: Plano) => string; preco?: boolean }[] = [
  { rotulo: 'Download', icone: 'download', valor: (p) => p.download },
  { rotulo: 'Upload', icone: 'upload', valor: (p) => p.upload },
  { rotulo: 'Preço por mês', valor: (p) => p.preco, preco: true },
];
---

{
  planos.length > 1 && (
    <Secao id="comparativo" tom="clara" class="hidden lg:block">
      <div class="grid gap-10 md:gap-12">
        <CabecalhoSecao titulo="Compare os planos" />

        <div data-revelar>
          <table class="comparativo">
            <caption class="sr-only">Comparativo dos planos: download, upload e preço por mês</caption>
            <thead>
              <tr>
                <td />
                {planos.map((p) => (
                  <th scope="col" class="tabular">
                    {p.nome}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {linhas.map((l) => (
                <tr class:list={{ 'comparativo__preco': l.preco }}>
                  <th scope="row">
                    <span class="comparativo__rotulo rotulo">
                      {l.icone && <Icone nome={l.icone} class="comparativo__icone" />}
                      {l.rotulo}
                    </span>
                  </th>
                  {planos.map((p) => {
                    const valor = l.valor(p);
                    const preco = l.preco ? valorPreco(valor) : null;
                    return (
                      <td class="tabular">
                        {preco ? (
                          <>
                            <span class="comparativo__moeda">R$</span> {preco}
                          </>
                        ) : l.preco ? (
                          'Sob consulta'
                        ) : (
                          valor
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </div>
    </Secao>
  )
}

<style>
  @layer components {
    .comparativo {
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      text-align: left;
    }
    .comparativo th,
    .comparativo td {
      padding: 1.25rem 1rem;
      border-bottom: 1px solid var(--sup-linha);
      vertical-align: middle;
      white-space: nowrap;
    }
    .comparativo thead th {
      padding-top: 0;
      color: var(--sup-titulo);
      font-size: var(--text-2xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
    }
    .comparativo thead th,
    .comparativo thead td {
      border-bottom-color: var(--color-marinho-200);
    }
    .comparativo__rotulo {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .comparativo__icone {
      width: 1.125rem;
      height: 1.125rem;
      color: var(--sup-icone);
    }
    .comparativo tbody td {
      color: var(--sup-titulo);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
    }
    .comparativo tbody .comparativo__preco td {
      font-size: var(--text-2xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
    }
    .comparativo__moeda {
      font-size: 0.6em;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0;
    }
  }
</style>
