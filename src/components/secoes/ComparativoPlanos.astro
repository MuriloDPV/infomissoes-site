---
// Comparativo dos planos (/planos/): tabela limpa com uma coluna por plano e as linhas Download, Upload e
// Preço por mês, com divisória fina. Nenhuma coluna destacada (não há "mais escolhido").
// No celular a tabela vira uma lista por plano (mesmas linhas), sem rolagem lateral.
// Fecha com o link para as cidades atendidas.
import Botao from '../ui/Botao.astro';
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Icone, { type IconeNome } from '../ui/Icone.astro';
import LinhasInfo from '../ui/LinhasInfo.astro';
import Secao from '../ui/Secao.astro';
import { site, type Plano } from '../../data/site.ts';
import { valorPreco } from '../../lib/contato.ts';

const planos = site.planos.casa.slice(0, 3);
const linhas: { rotulo: string; icone?: IconeNome; valor: (p: Plano) => string; preco?: boolean }[] = [
  { rotulo: 'Download', icone: 'download', valor: (p) => p.download },
  { rotulo: 'Upload', icone: 'upload', valor: (p) => p.upload },
  { rotulo: 'Preço por mês', valor: (p) => p.preco, preco: true },
];
---

{
  planos.length > 0 && (
    <Secao id="comparativo" tom="clara">
      <div class="grid gap-10 md:gap-12">
        <CabecalhoSecao titulo="Compare os planos" />

        <div data-revelar>
          <table class="comparativo">
            <caption class="sr-only">Comparativo dos planos: download, upload e preço por mês</caption>
            <thead>
              <tr>
                <td />
                {planos.map((p) => (
                  <th scope="col" class="tabular">
                    {p.nome}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {linhas.map((l) => (
                <tr class:list={{ 'comparativo__preco': l.preco }}>
                  <th scope="row">
                    <span class="comparativo__rotulo rotulo">
                      {l.icone && <Icone nome={l.icone} class="comparativo__icone" />}
                      {l.rotulo}
                    </span>
                  </th>
                  {planos.map((p) => {
                    const valor = l.valor(p);
                    const preco = l.preco ? valorPreco(valor) : null;
                    return (
                      <td class="tabular">
                        {preco ? (
                          <>
                            <span class="comparativo__moeda">R$</span> {preco}
                          </>
                        ) : (
                          valor
                        )}
                      </td>
                    );
                  })}
                </tr>
              ))}
            </tbody>
          </table>

          <ul class="comparativo-lista">
            {planos.map((p) => (
              <li class="comparativo-lista__plano">
                <h3 class="comparativo-lista__nome tabular">{p.nome}</h3>
                <LinhasInfo
                  compacto
                  linhas={linhas.map((l) => ({ rotulo: l.rotulo, icone: l.icone, valor: l.valor(p), destaque: l.preco }))}
                />
              </li>
            ))}
          </ul>
        </div>

        <Botao href="/onde-atendemos/" variante="link" seta class="justify-self-start">
          Ver as cidades onde atendemos
        </Botao>
      </div>
    </Secao>
  )
}

<style>
  @layer components {
    /* Tabela: só a partir do tablet */
    .comparativo {
      display: none;
      width: 100%;
      border-collapse: collapse;
      table-layout: fixed;
      text-align: left;
    }
    @media (width >= 48rem) {
      .comparativo {
        display: table;
      }
    }
    .comparativo th,
    .comparativo td {
      padding: 1.25rem 1rem;
      border-bottom: 1px solid var(--sup-linha);
      vertical-align: middle;
    }
    .comparativo thead th {
      padding-top: 0;
      color: var(--sup-titulo);
      font-size: var(--text-2xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
    }
    .comparativo thead th,
    .comparativo thead td {
      border-bottom-color: var(--color-marinho-200);
    }
    .comparativo__rotulo {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
    }
    .comparativo__icone {
      width: 1.125rem;
      height: 1.125rem;
      color: var(--sup-icone);
    }
    .comparativo tbody td {
      color: var(--sup-titulo);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
    }
    .comparativo tbody .comparativo__preco td {
      font-size: var(--text-2xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
    }
    .comparativo__moeda {
      font-size: 0.6em;
      font-weight: var(--font-weight-bold);
      letter-spacing: 0;
    }

    /* Lista: só no celular */
    .comparativo-lista {
      display: grid;
      gap: 1rem;
    }
    @media (width >= 48rem) {
      .comparativo-lista {
        display: none;
      }
    }
    .comparativo-lista__plano {
      container-type: inline-size;
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      padding: 1.25rem 1.25rem 0.5rem;
      border-radius: var(--radius-2xl);
      background-color: var(--sup-cartao);
      --sup-linha: var(--sup-cartao-linha);
    }
    .comparativo-lista__nome {
      font-size: var(--text-xl);
      font-weight: var(--font-weight-extrabold);
    }
    .comparativo-lista__plano :global(.linhas__linha:last-child) {
      border-bottom: 0;
    }
  }
</style>
