---
// Comparativo dos planos (/planos/): tabela com uma coluna por plano e as linhas Download, Upload e
// Preço por mês. Nenhuma coluna destacada. No celular a tabela vira uma lista por plano, sem rolagem lateral.
// Fecha com o link para as cidades atendidas.
import Botao from '../ui/Botao.astro';
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Secao from '../ui/Secao.astro';
import { site } from '../../data/site.ts';

const planos = site.planos.slice(0, 3);
const linhas = [
  { rotulo: 'Download', valor: (p: (typeof planos)[number]) => p.download },
  { rotulo: 'Upload', valor: (p: (typeof planos)[number]) => p.upload },
  { rotulo: 'Preço por mês', valor: (p: (typeof planos)[number]) => p.preco },
];
---

{
  planos.length > 0 && (
    <Secao id="comparativo" tom="clara">
      <div class="grid gap-10 md:gap-12">
        <CabecalhoSecao titulo="Compare os planos" />

        <div data-revelar>
          <table class="comparativo">
            <caption class="sr-only">Comparativo dos planos: download, upload e preço por mês</caption>
            <thead>
              <tr>
                <td />
                {planos.map((p) => (
                  <th scope="col" class="tabular">
                    {p.nome}
                  </th>
                ))}
              </tr>
            </thead>
            <tbody>
              {linhas.map((l) => (
                <tr>
                  <th scope="row">{l.rotulo}</th>
                  {planos.map((p) => (
                    <td class="tabular">{l.valor(p)}</td>
                  ))}
                </tr>
              ))}
            </tbody>
          </table>

          <ul class="comparativo-lista">
            {planos.map((p) => (
              <li class="comparativo-lista__plano">
                <h3 class="comparativo-lista__nome tabular">{p.nome}</h3>
                <dl>
                  {linhas.map((l) => (
                    <div class="comparativo-lista__linha">
                      <dt>{l.rotulo}</dt>
                      <dd class="tabular">{l.valor(p)}</dd>
                    </div>
                  ))}
                </dl>
              </li>
            ))}
          </ul>
        </div>

        <Botao href="/onde-atendemos/" variante="link" seta class="justify-self-start">
          Ver as cidades onde atendemos
        </Botao>
      </div>
    </Secao>
  )
}

<style>
  @layer components {
    /* Tabela: só a partir do tablet */
    .comparativo {
      display: none;
      width: 100%;
      border-collapse: collapse;
      text-align: left;
    }
    @media (width >= 48rem) {
      .comparativo {
        display: table;
      }
    }
    .comparativo th,
    .comparativo td {
      padding: 1.125rem 1rem;
      border-bottom: 1px solid var(--sup-linha);
    }
    .comparativo thead th {
      color: var(--sup-titulo);
      font-size: var(--text-xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
    }
    .comparativo tbody th {
      color: var(--sup-suave);
      font-weight: var(--font-weight-semibold);
    }
    .comparativo tbody td {
      color: var(--sup-titulo);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
    }

    /* Lista: só no celular */
    .comparativo-lista {
      display: grid;
      gap: 1rem;
    }
    @media (width >= 48rem) {
      .comparativo-lista {
        display: none;
      }
    }
    .comparativo-lista__plano {
      padding: 1.25rem 1.25rem 0.5rem;
      border-radius: var(--radius-2xl);
      background-color: var(--color-fundo);
    }
    .comparativo-lista__nome {
      font-size: var(--text-xl);
      font-weight: var(--font-weight-extrabold);
    }
    .comparativo-lista__linha {
      display: flex;
      align-items: baseline;
      justify-content: space-between;
      gap: 1rem;
      padding-block: 0.875rem;
      border-bottom: 1px solid var(--sup-linha);
    }
    .comparativo-lista__linha:last-child {
      border-bottom: 0;
    }
    .comparativo-lista__linha dt {
      color: var(--sup-suave);
      font-weight: var(--font-weight-semibold);
    }
    .comparativo-lista__linha dd {
      color: var(--sup-titulo);
      font-weight: var(--font-weight-bold);
      white-space: nowrap;
    }
  }
</style>
