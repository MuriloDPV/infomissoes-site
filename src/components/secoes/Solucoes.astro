---
// "Soluções para cada perfil" (Início): um cartão por categoria de planos (Para sua casa, Para sua empresa,
// Interior), cada um levando à sua página. A frase de cada cartão sai dos dados (tecnologia, planos e preço).
// Mesma leitura dos atalhos de "Já é cliente?": no celular em linha, no desktop três cartões lado a lado.
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Icone from '../ui/Icone.astro';
import Secao from '../ui/Secao.astro';
import { categorias, resumo } from '../../lib/planos.ts';
---

<Secao id="solucoes" tom="suave">
  <div class="grid gap-8 md:gap-10">
    <CabecalhoSecao titulo="Soluções para cada perfil" />

    <ul class="grid gap-3 md:gap-4 lg:grid-cols-3 lg:gap-5">
      {
        categorias.map((c, i) => (
          <li class="flex" data-revelar style={`--i:${i + 1}`}>
            <a class="perfil" href={c.href}>
              <Icone nome={c.icone} class="perfil__icone" />
              <div class="perfil__textos">
                <h3 class="perfil__titulo">{c.rotulo}</h3>
                <p class="perfil__texto">{resumo(c)}</p>
              </div>
              <Icone nome="seta" class="perfil__seta" />
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Secao>

<style>
  @layer components {
    /* Cartão-link no fundo de cartão da superfície, sem borda. No hover o fundo escurece um pouco e a seta anda. */
    .perfil {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      width: 100%;
      min-height: 5.5rem;
      padding: 1.25rem 1.125rem 1.25rem 1.25rem;
      border-radius: var(--radius-2xl);
      background-color: var(--sup-cartao);
      color: var(--color-cinza);
      text-decoration: none;
      touch-action: manipulation;
    }

    .perfil::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      border-radius: inherit;
      background-color: var(--sup-cartao-realce);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duracao-cor) var(--ease-suave);
    }

    .perfil__icone {
      width: 1.75rem;
      height: 1.75rem;
      color: var(--color-azul);
    }

    .perfil__textos {
      display: flex;
      flex-direction: column;
      gap: 0.25rem;
    }

    .perfil__titulo {
      color: var(--color-marinho);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.01em;
      line-height: var(--leading-titulo);
    }

    .perfil__texto {
      color: var(--color-marinho-600);
      font-size: var(--text-sm);
      line-height: 1.45;
    }

    .perfil__seta {
      width: 1.375rem;
      height: 1.375rem;
      color: var(--color-marinho);
      transition: transform var(--duracao-base) var(--ease-saida);
    }

    @media (hover: hover) {
      .perfil:hover::before {
        opacity: 1;
      }
      .perfil:hover .perfil__seta {
        transform: translate3d(4px, 0, 0);
      }
    }

    .perfil:active::before {
      opacity: 1;
    }

    .perfil:focus-visible {
      outline-offset: 3px;
    }

    /* Desktop: três cartões lado a lado, ícone e seta em cima, textos embaixo */
    @media (width >= 64rem) {
      .perfil {
        grid-template-columns: 1fr auto;
        grid-template-rows: auto 1fr;
        align-items: start;
        row-gap: 2.5rem;
        height: 100%;
        padding: 1.75rem 1.75rem 1.875rem;
      }
      .perfil__icone {
        width: 2rem;
        height: 2rem;
      }
      .perfil__textos {
        grid-column: 1 / -1;
        grid-row: 2;
        align-self: end;
        gap: 0.375rem;
      }
      .perfil__titulo {
        font-size: var(--text-xl);
      }
      .perfil__seta {
        grid-column: 2;
        grid-row: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .perfil__seta {
        transition: none;
      }
      .perfil:hover .perfil__seta {
        transform: none;
      }
    }
  }
</style>
