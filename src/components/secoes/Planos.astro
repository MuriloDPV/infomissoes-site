---
// Planos de uma categoria (dados de site.ts; categorias em src/lib/planos.ts). Sem planos, um convite neutro
// para consultar.
// Páginas de planos (padrão): cartões completos com o botão do WhatsApp e, embaixo, as condições que valem para
// todos os planos (uma vez só, cada uma com o seu ícone), o aviso da instalação e o link para as cidades
// (o h1 fica na abertura da página). Com um plano só, as condições ficam ao lado do cartão no desktop, depois
// de um texto curto da categoria (`texto`).
// `resumo` (Início): faixa clara com título, cartões compactos (brancos) dos planos para casa e o botão
// "Ver os planos".
import Botao from '../ui/Botao.astro';
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import CardPlano from '../ui/CardPlano.astro';
import Icone from '../ui/Icone.astro';
import Pendente from '../ui/Pendente.astro';
import Secao from '../ui/Secao.astro';
import { site } from '../../data/site.ts';
import { DEV, whatsapp } from '../../lib/dados.ts';
import { categoria as porChave, planosDa, type ChaveCategoria } from '../../lib/planos.ts';

interface Props {
  categoria?: ChaveCategoria;
  resumo?: boolean;
  /** Texto curto da categoria, antes das condições. */
  texto?: string;
}

const { categoria: chave = 'casa', resumo = false, texto: textoCategoria } = Astro.props;
const categoria = porChave(chave);
const planos = planosDa(chave);
const temPlanos = planos.length > 0;
const unico = !resumo && planos.length === 1;

const texto = temPlanos
  ? '100% fibra óptica até a sua casa. Veja os detalhes de cada plano e contrate pelo WhatsApp.'
  : 'Consulte os planos disponíveis no seu endereço. Fale com a gente e informe a sua rua e a sua cidade.';
---

<Secao id="planos" tom={resumo ? 'faixa' : 'suave'}>
  {resumo && <CabecalhoSecao titulo="Planos para sua casa" texto={texto} />}
  {!resumo && !temPlanos && <p class="max-w-texto text-lg text-sup-suave">{texto}</p>}

  {
    temPlanos && (
      <div class:list={['planos', { 'planos--unico': unico }]}>
        <ul class:list={['planos__cartoes', resumo && 'mt-10 md:mt-12']}>
          {planos.map((p, i) => (
            <li class="flex" data-revelar style={`--i:${i + 1}`}>
              <CardPlano
                plano={p}
                compacto={resumo}
                nivel={resumo ? 3 : 2}
                mensagem={categoria.mensagem(p)}
                acao={categoria.acao}
              />
            </li>
          ))}
        </ul>

        {!resumo && (
          <div class="planos__condicoes" data-revelar style={unico ? '--i:2' : undefined}>
            {textoCategoria && <p class="planos__texto">{textoCategoria}</p>}
            <ul class="planos__lista">
              {site.condicoesPlanos.map((c) => (
                <li class="planos__condicao">
                  <Icone nome={c.icone} class="planos__icone" />
                  <span>{c.texto}</span>
                </li>
              ))}
            </ul>
            <p class="planos__aviso">{site.avisoPlanos}</p>
            <Botao href="/onde-atendemos/" variante="link" seta>
              Ver as cidades atendidas
            </Botao>
          </div>
        )}
      </div>
    )
  }

  {
    !temPlanos && DEV && (
      <ul class="mt-12 grid gap-5 lg:grid-cols-3">
        {[1, 2, 3].map((n) => (
          <li>
            <Pendente texto={`plano ${n}: nome, download, upload e preço`} campo={`planos.${chave}`} class="min-h-64" />
          </li>
        ))}
      </ul>
    )
  }

  {
    (resumo || !temPlanos) && (
      <div class="planos__pe" data-revelar>
        {temPlanos && <p class="planos__aviso">{site.avisoPlanos}</p>}
        {resumo && temPlanos ? (
          <Botao href="/planos/" tamanho="lg" seta class="planos__acao">
            Ver os planos
          </Botao>
        ) : temPlanos ? null : whatsapp ? (
          <Botao href={whatsapp} externo indicador={false} icone="whatsapp" tamanho="lg" data-cta-whatsapp>
            Consultar no WhatsApp
          </Botao>
        ) : (
          <Botao href="/contato/" tamanho="lg" seta>
            Ver formas de contato
          </Botao>
        )}
      </div>
    )
  }
</Secao>

<style>
  @layer components {
    .planos__cartoes {
      display: grid;
      gap: 1.25rem;
    }
    @media (width >= 64rem) {
      .planos:not(.planos--unico) .planos__cartoes {
        grid-template-columns: repeat(3, minmax(0, 1fr));
        align-items: stretch;
      }
    }

    /* Condições comuns a todos os planos: uma vez só, embaixo dos cartões, cada uma com o seu ícone */
    .planos__condicoes {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      margin-top: 2rem;
    }
    @media (width >= 48rem) {
      .planos__condicoes {
        margin-top: 2.5rem;
      }
    }
    .planos__texto {
      max-width: var(--container-texto);
      color: var(--sup-titulo);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-semibold);
      letter-spacing: -0.01em;
      line-height: 1.45;
      margin-bottom: 0.5rem;
    }
    @media (width >= 48rem) {
      .planos__texto {
        font-size: var(--text-xl);
        line-height: 1.4;
      }
    }
    .planos__lista {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
    }
    .planos__condicao {
      display: flex;
      align-items: flex-start;
      gap: 0.75rem;
      max-width: var(--container-texto);
    }
    .planos__icone {
      width: 1.5rem;
      height: 1.5rem;
      flex: none;
      margin-top: 0.1875rem;
      color: var(--sup-icone);
    }

    /* Um plano só (empresa, interior): no desktop, o cartão à esquerda e as condições ao lado */
    @media (width >= 64rem) {
      .planos--unico {
        display: grid;
        grid-template-columns: minmax(0, 30rem) minmax(0, 1fr);
        align-items: center;
        gap: 4.5rem;
      }
      .planos--unico .planos__condicoes {
        margin-top: 0;
      }
    }

    /* Pé do resumo da Início (ou sem planos): aviso e a ação, lado a lado a partir do tablet */
    .planos__pe {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      margin-top: 2rem;
    }
    @media (width >= 48rem) {
      .planos__pe {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem 2.5rem;
        margin-top: 2.5rem;
      }
    }

    .planos__aviso {
      max-width: var(--container-texto);
      color: var(--sup-titulo);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-semibold);
      line-height: var(--text-lg--line-height);
    }

    /* No celular, o botão ocupa a largura toda */
    @media (width < 48rem) {
      .planos__pe :global(.planos__acao) {
        width: 100%;
      }
    }
  }
</style>
