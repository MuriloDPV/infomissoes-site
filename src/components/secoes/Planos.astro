---
// Planos (dados de site.ts). Sem planos, um convite neutro para consultar.
// Página /planos/ (padrão): cartões completos com o botão do WhatsApp e o aviso das condições
// (o h1 fica na abertura da página).
// `resumo` (Início): faixa clara com título, cartões compactos (brancos) e o botão "Ver os planos".
import Botao from '../ui/Botao.astro';
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import CardPlano from '../ui/CardPlano.astro';
import Pendente from '../ui/Pendente.astro';
import Secao from '../ui/Secao.astro';
import { site } from '../../data/site.ts';
import { DEV, whatsapp } from '../../lib/dados.ts';

interface Props {
  resumo?: boolean;
}

const { resumo = false } = Astro.props;
const planos = site.planos.slice(0, 3);
const temPlanos = planos.length > 0;

const texto = temPlanos
  ? 'Internet de fibra óptica até a sua casa. Veja os detalhes de cada plano e contrate pelo WhatsApp.'
  : 'Consulte os planos disponíveis no seu endereço. Fale com a gente e informe a sua rua e a sua cidade.';
---

<Secao id="planos" tom={resumo ? 'faixa' : 'suave'}>
  {resumo && <CabecalhoSecao titulo="Planos de internet" texto={texto} />}
  {!resumo && !temPlanos && <p class="max-w-texto text-lg text-sup-suave">{texto}</p>}

  {
    temPlanos && (
      <ul class:list={['grid gap-5 lg:grid-cols-3 lg:items-stretch', resumo && 'mt-10 md:mt-12']}>
        {planos.map((p, i) => (
          <li class="flex" data-revelar style={`--i:${i + 1}`}>
            <CardPlano plano={p} compacto={resumo} nivel={resumo ? 3 : 2} />
          </li>
        ))}
      </ul>
    )
  }

  {
    !temPlanos && DEV && (
      <ul class="mt-12 grid gap-5 lg:grid-cols-3">
        {[1, 2, 3].map((n) => (
          <li>
            <Pendente texto={`plano ${n}: nome, download, upload e preço`} campo="planos" class="min-h-64" />
          </li>
        ))}
      </ul>
    )
  }

  <div class="planos__pe" data-revelar>
    {temPlanos && <p class="planos__aviso">{site.avisoPlanos}</p>}
    {
      resumo && temPlanos ? (
        <Botao href="/planos/" tamanho="lg" seta class="planos__acao">
          Ver os planos
        </Botao>
      ) : temPlanos ? null : whatsapp ? (
        <Botao href={whatsapp} externo indicador={false} icone="whatsapp" tamanho="lg" data-cta-whatsapp>
          Consultar no WhatsApp
        </Botao>
      ) : (
        <Botao href="/contato/" tamanho="lg" seta>
          Ver formas de contato
        </Botao>
      )
    }
  </div>
</Secao>

<style>
  @layer components {
    /* Pé da seção: aviso das condições e a ação (lado a lado a partir do tablet) */
    .planos__pe {
      display: flex;
      flex-direction: column;
      align-items: flex-start;
      gap: 1.25rem;
      margin-top: 2rem;
    }
    @media (width >= 48rem) {
      .planos__pe {
        flex-direction: row;
        flex-wrap: wrap;
        align-items: center;
        justify-content: space-between;
        gap: 1.5rem 2.5rem;
        margin-top: 2.5rem;
      }
    }

    .planos__aviso {
      max-width: var(--container-texto);
      color: var(--sup-titulo);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-semibold);
      line-height: var(--text-lg--line-height);
    }

    /* No celular, o botão ocupa a largura toda */
    @media (width < 48rem) {
      .planos__pe :global(.planos__acao) {
        width: 100%;
      }
    }
  }
</style>
