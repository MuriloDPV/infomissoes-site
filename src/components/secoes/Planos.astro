---
// Planos: só mostra o que estiver em site.ts. Sem planos, um convite neutro para consultar.
import Botao from '../ui/Botao.astro';
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Card from '../ui/Card.astro';
import Icone from '../ui/Icone.astro';
import Pendente from '../ui/Pendente.astro';
import Secao from '../ui/Secao.astro';
import Selo from '../ui/Selo.astro';
import { site } from '../../data/site.ts';
import { DEV, whatsapp, whatsappMensagem } from '../../lib/dados.ts';

const planos = site.planos.slice(0, 3);
const temPlanos = planos.length > 0;
---

<Secao id="planos" tom="tinta">
  <CabecalhoSecao
    titulo="Planos de internet"
    texto={temPlanos ? 'Escolha o plano e fale com a gente para contratar.' : undefined}
  />

  {
    temPlanos && (
      <ul class="mt-12 grid gap-6 lg:grid-cols-3 lg:items-stretch">
        {planos.map((p, i) => {
          const link = whatsappMensagem(`Tenho interesse no plano ${p.nome} (${p.velocidade}).`);
          return (
            <li class="flex" data-revelar style={`--i:${i + 1}`}>
              <Card as="article" variante={p.selo ? 'azul' : 'claro'} interativo class="w-full gap-6 p-7 md:p-8">
                <header class="flex flex-col items-start gap-3">
                  {p.selo && <Selo class="absolute -top-4 left-7 shadow-sm md:left-8">{p.selo}</Selo>}
                  <h3 class="text-xl">{p.nome}</h3>
                </header>
                <p class="tabular text-3xl font-extrabold tracking-destaque text-sup-titulo">{p.velocidade}</p>
                <p class="flex items-baseline gap-2">
                  <span class="tabular text-2xl font-extrabold text-sup-titulo">{p.preco}</span>
                  <span class="text-sup-suave">{p.periodo ?? 'por mês'}</span>
                </p>
                {p.beneficios.length > 0 && (
                  <ul class="flex flex-col gap-3 border-t border-sup-linha pt-6">
                    {p.beneficios.map((b) => (
                      <li class="flex gap-3">
                        <Icone nome="check" class="mt-1 size-5 shrink-0 text-sup-icone" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto pt-2">
                  {link ? (
                    <Botao href={link} externo indicador={false} icone="whatsapp" variante={p.selo ? 'primario' : 'secundario'} cheio>
                      Quero este plano
                    </Botao>
                  ) : (
                    <Botao href="#contato" variante={p.selo ? 'primario' : 'secundario'} seta cheio>
                      Quero este plano
                    </Botao>
                  )}
                </div>
              </Card>
            </li>
          );
        })}
      </ul>
    )
  }

  {
    !temPlanos && DEV && (
      <ul class="mt-12 grid gap-6 lg:grid-cols-3">
        {[1, 2, 3].map((n) => (
          <li>
            <Pendente texto={`plano ${n}: nome, velocidade, preço e benefícios`} campo="planos" class="min-h-80" />
          </li>
        ))}
      </ul>
    )
  }

  {
    !temPlanos && (
      <div class="mt-12" data-revelar>
        {DEV && (
          <p class="mb-3 text-sm text-sup-suave">Sem planos em site.ts, o site publicado mostra este bloco no lugar:</p>
        )}
        <Card class="gap-8 p-7 md:flex-row md:items-center md:justify-between md:p-10">
          <div class="flex max-w-texto flex-col gap-3">
            <h3 class="text-2xl">Consulte os planos disponíveis no seu endereço</h3>
            <p class="text-sup-suave">
              Fale com a gente e informe a sua rua e a sua cidade. Assim indicamos os planos que você pode contratar.
            </p>
          </div>
          {whatsapp ? (
            <Botao href={whatsapp} externo indicador={false} icone="whatsapp" tamanho="lg" class="shrink-0">
              Consultar no WhatsApp
            </Botao>
          ) : (
            <Botao href="#contato" variante="secundario" tamanho="lg" seta class="shrink-0">
              Ver formas de contato
            </Botao>
          )}
        </Card>
      </div>
    )
  }
</Secao>
