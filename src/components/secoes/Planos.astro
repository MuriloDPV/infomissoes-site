---
// Planos: só mostra o que estiver em site.ts. Sem planos, um convite neutro para consultar.
// Faixa marinho no meio da página: é onde o botão amarelo aparece.
import Botao from '../ui/Botao.astro';
import Card from '../ui/Card.astro';
import Icone from '../ui/Icone.astro';
import Ondas from '../ui/Ondas.astro';
import Pendente from '../ui/Pendente.astro';
import Secao from '../ui/Secao.astro';
import Selo from '../ui/Selo.astro';
import { site } from '../../data/site.ts';
import { DEV, whatsapp, whatsappMensagem } from '../../lib/dados.ts';

const planos = site.planos.slice(0, 3);
const temPlanos = planos.length > 0;
---

<Secao id="planos" tom="marinho" class="overflow-hidden">
  <Ondas ponto={false} class="planos__ondas" />

  <div class="grid gap-10 lg:grid-cols-12 lg:items-end lg:gap-12">
    <header class="flex flex-col gap-5 lg:col-span-7" data-revelar>
      <h2 class="text-3xl">Planos de internet</h2>
      {
        temPlanos ? (
          <p class="max-w-texto text-lg text-sup-suave">Escolha o plano e fale com a gente para contratar.</p>
        ) : (
          <>
            <p class="max-w-texto text-xl font-bold text-sup-titulo">Consulte os planos disponíveis no seu endereço.</p>
            <p class="max-w-texto text-lg text-sup-suave">
              Fale com a gente e informe a sua rua e a sua cidade. Assim indicamos os planos que você pode contratar.
            </p>
          </>
        )
      }
    </header>

    {
      !temPlanos && (
        <div class="lg:col-span-5 lg:justify-self-end" data-revelar style="--i:2">
          {DEV && <p class="mb-3 text-sm text-sup-suave">Sem planos em site.ts, o site publicado mostra este botão:</p>}
          {whatsapp ? (
            <Botao href={whatsapp} externo indicador={false} icone="whatsapp" variante="destaque" tamanho="lg">
              Consultar no WhatsApp
            </Botao>
          ) : (
            <Botao href="#contato" variante="destaque" tamanho="lg" seta>
              Ver formas de contato
            </Botao>
          )}
        </div>
      )
    }
  </div>

  {
    temPlanos && (
      <ul class="mt-12 grid gap-5 lg:grid-cols-3 lg:items-stretch">
        {planos.map((p, i) => {
          const link = whatsappMensagem(`Tenho interesse no plano ${p.nome} (${p.velocidade}).`);
          return (
            <li class="flex" data-revelar style={`--i:${i + 1}`}>
              <Card as="article" interativo class:list={['w-full gap-6 p-7 md:p-8', p.selo && 'card--selo']}>
                <header class="flex flex-col items-start gap-3">
                  {p.selo && <Selo class="absolute -top-4 left-7 shadow-sm md:left-8">{p.selo}</Selo>}
                  <h3 class="text-xl">{p.nome}</h3>
                </header>
                <p class="tabular text-3xl font-extrabold tracking-destaque text-sup-titulo">{p.velocidade}</p>
                <p class="flex items-baseline gap-2">
                  <span class="tabular text-2xl font-extrabold text-sup-titulo">{p.preco}</span>
                  <span class="text-sup-suave">{p.periodo ?? 'por mês'}</span>
                </p>
                {p.beneficios.length > 0 && (
                  <ul class="flex flex-col gap-3 border-t border-sup-linha pt-6">
                    {p.beneficios.map((b) => (
                      <li class="flex gap-3">
                        <Icone nome="check" class="mt-1 size-5 shrink-0 text-sup-icone" />
                        <span>{b}</span>
                      </li>
                    ))}
                  </ul>
                )}
                <div class="mt-auto pt-2">
                  {link ? (
                    <Botao href={link} externo indicador={false} icone="whatsapp" variante={p.selo ? 'destaque' : 'primario'} cheio>
                      Quero este plano
                    </Botao>
                  ) : (
                    <Botao href="#contato" variante={p.selo ? 'destaque' : 'primario'} seta cheio>
                      Quero este plano
                    </Botao>
                  )}
                </div>
              </Card>
            </li>
          );
        })}
      </ul>
    )
  }

  {
    !temPlanos && DEV && (
      <ul class="mt-12 grid gap-5 lg:grid-cols-3">
        {[1, 2, 3].map((n) => (
          <li>
            <Pendente texto={`plano ${n}: nome, velocidade, preço e benefícios`} campo="planos" class="min-h-64" />
          </li>
        ))}
      </ul>
    )
  }
</Secao>

<style>
  @layer components {
    .planos__ondas {
      --sx: 100%;
      --sy: 100%;
      --tamanho: 760px;
    }
    @media (width >= 64rem) {
      .planos__ondas {
        --sx: 96%;
        --sy: 110%;
        --tamanho: 1100px;
      }
    }

    /* Plano em destaque: contorno amarelo */
    :global(.card--selo) {
      box-shadow:
        inset 0 0 0 2px var(--color-amarelo),
        var(--shadow-md);
    }
  }
</style>
