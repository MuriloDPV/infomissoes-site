---
// Portal do cliente (7az): o que dá para fazer lá + botão para abrir.
import Botao from '../ui/Botao.astro';
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Icone, { type IconeNome } from '../ui/Icone.astro';
import Secao from '../ui/Secao.astro';
import { portal } from '../../lib/dados.ts';

const itens: { icone: IconeNome; texto: string }[] = [
  { icone: 'fatura', texto: 'Tirar a 2ª via da fatura' },
  { icone: 'pix', texto: 'Pagar com PIX' },
  { icone: 'faturas', texto: 'Ver as suas faturas' },
];
---

<Secao id="portal" tom="amarela">
  <div class="grid gap-12 lg:grid-cols-12 lg:items-center lg:gap-16">
    <CabecalhoSecao
      class="lg:col-span-6"
      titulo="Sua conta pela internet"
      texto={`${portal.a.charAt(0).toUpperCase()}${portal.a.slice(1)} é o portal do cliente Info Missões. Funciona no celular e no computador.`}
    >
      <div class="pt-4">
        <Botao href={portal.url} externo variante="secundario" icone="usuario" tamanho="lg">
          {portal.nome}
        </Botao>
      </div>
    </CabecalhoSecao>

    <ul class="lg:col-span-6">
      {
        itens.map((item, i) => (
          <li class="portal-item" data-revelar="lado" style={`--i:${i + 1}`}>
            <Icone nome={item.icone} class="size-8 shrink-0 text-sup-icone" />
            <span>{item.texto}</span>
          </li>
        ))
      }
    </ul>
  </div>
</Secao>

<style>
  @layer components {
    .portal-item {
      display: flex;
      align-items: center;
      gap: 1.25rem;
      min-height: 5.5rem;
      border-bottom: 1px solid var(--sup-linha);
      color: var(--color-azul);
      font-size: var(--text-2xl);
      font-weight: var(--font-weight-extrabold);
      letter-spacing: var(--tracking-titulo);
      line-height: var(--leading-titulo);
    }

    .portal-item:first-child {
      border-top: 1px solid var(--sup-linha);
    }
  }
</style>
