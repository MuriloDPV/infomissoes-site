---
// "Já é cliente?": atalhos grandes para o portal (nova aba). É o caminho mais curto no celular.
import CabecalhoSecao from '../ui/CabecalhoSecao.astro';
import Icone, { type IconeNome } from '../ui/Icone.astro';
import Secao from '../ui/Secao.astro';
import { portal } from '../../lib/dados.ts';

const atalhos: { icone: IconeNome; titulo: string; texto: string }[] = [
  { icone: 'fatura', titulo: '2ª via da fatura', texto: 'Emita de novo, se perdeu ou não recebeu.' },
  { icone: 'pix', titulo: 'Pagar com PIX', texto: 'Copie o código e pague no app do banco.' },
  { icone: 'faturas', titulo: 'Ver faturas', texto: 'Consulte as suas faturas.' },
];
---

<Secao id="ja-e-cliente" tom="clara" ritmo="curta">
  <div class="grid gap-8 md:gap-10">
    <CabecalhoSecao
      titulo="Já é cliente?"
      texto={`Resolva ${portal.na}. Os atalhos abrem em uma nova aba.`}
    />

    <ul class="grid gap-3 md:gap-4 lg:grid-cols-3 lg:gap-5">
      {
        atalhos.map((a, i) => (
          <li class="flex" data-revelar style={`--i:${i + 1}`}>
            <a class="atalho" href={portal.url} target="_blank" rel="noopener">
              <Icone nome={a.icone} class="atalho__icone" />
              <span class="atalho__textos">
                <span class="atalho__titulo">{a.titulo}</span>
                <span class="atalho__texto">{a.texto}</span>
              </span>
              <Icone nome="externo" class="atalho__seta" />
              <span class="sr-only"> (abre em nova aba)</span>
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</Secao>

<style>
  @layer components {
    /* Atalho com cara de botão grande: fundo claro, contorno fino, sobe um pouco no hover */
    .atalho {
      position: relative;
      isolation: isolate;
      display: grid;
      grid-template-columns: auto 1fr auto;
      align-items: center;
      gap: 1rem;
      width: 100%;
      min-height: 5.5rem;
      padding: 1.125rem 1.125rem 1.125rem 1.25rem;
      border-radius: var(--radius-xl);
      background-color: var(--color-fundo);
      box-shadow: inset 0 0 0 1px var(--color-marinho-100);
      color: var(--color-cinza);
      text-decoration: none;
      transition: transform var(--duracao-lenta) var(--ease-saida);
      touch-action: manipulation;
    }

    /* Realce (branco com contorno mais forte) e sombra: só opacidade */
    .atalho::before,
    .atalho::after {
      content: '';
      position: absolute;
      inset: 0;
      border-radius: inherit;
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duracao-lenta) var(--ease-saida);
    }
    .atalho::before {
      z-index: -1;
      background-color: var(--color-branco);
      box-shadow: inset 0 0 0 1px var(--color-marinho-200);
    }
    .atalho::after {
      z-index: -2;
      box-shadow: var(--shadow-md);
    }

    .atalho__icone {
      width: 1.875rem;
      height: 1.875rem;
      color: var(--color-azul);
    }

    .atalho__textos {
      display: flex;
      flex-direction: column;
      gap: 0.125rem;
    }

    .atalho__titulo {
      color: var(--color-marinho);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
      letter-spacing: -0.01em;
      line-height: var(--leading-titulo);
    }

    .atalho__texto {
      color: var(--color-marinho-600);
      font-size: var(--text-sm);
      line-height: 1.45;
    }

    .atalho__seta {
      width: 1.375rem;
      height: 1.375rem;
      color: var(--color-marinho);
      transition: transform var(--duracao-lenta) var(--ease-saida);
    }

    @media (hover: hover) {
      .atalho:hover {
        transform: translate3d(0, -3px, 0);
      }
      .atalho:hover::before,
      .atalho:hover::after {
        opacity: 1;
      }
      .atalho:hover .atalho__seta {
        transform: translate3d(3px, -3px, 0);
      }
    }

    .atalho:active {
      transform: scale(0.985);
      transition-duration: var(--duracao-rapida);
    }
    .atalho:active::before {
      opacity: 1;
    }

    .atalho:focus-visible {
      outline-offset: 3px;
    }

    /* Desktop: três cartões lado a lado */
    @media (width >= 64rem) {
      .atalho {
        grid-template-columns: 1fr auto;
        grid-template-rows: auto 1fr;
        align-items: start;
        row-gap: 1.75rem;
        height: 100%;
        padding: 1.5rem 1.5rem 1.625rem;
      }
      .atalho__icone {
        width: 2.125rem;
        height: 2.125rem;
      }
      .atalho__textos {
        grid-column: 1 / -1;
        grid-row: 2;
        align-self: end;
        gap: 0.375rem;
      }
      .atalho__titulo {
        font-size: var(--text-xl);
      }
      .atalho__seta {
        grid-column: 2;
        grid-row: 1;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .atalho,
      .atalho__seta {
        transition: none;
      }
      .atalho:hover,
      .atalho:active,
      .atalho:hover .atalho__seta {
        transform: none;
      }
    }
  }
</style>
