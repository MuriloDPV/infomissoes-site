---
import Icone from '../ui/Icone.astro';
import Logo from '../ui/Logo.astro';
import Pendente from '../ui/Pendente.astro';
import { site } from '../../data/site.ts';
import { DEV, portal, telefone, whatsapp } from '../../lib/dados.ts';
import { atual, paginas } from '../../lib/navegacao.ts';

const ano = new Date().getFullYear();
const caminho = Astro.url.pathname;
---

<footer class="rodape sup-noite">
  <div class="mx-auto grid w-full max-w-pagina gap-12 px-calha py-16 md:grid-cols-2 lg:grid-cols-12 lg:py-24">
    <div class="flex flex-col items-start gap-6 md:col-span-2 lg:col-span-5">
      <Logo tom="escuro" class="rodape__logo" />
      <p class="max-w-estreito text-sup-suave">Internet de fibra óptica na região das Missões, Rio Grande do Sul.</p>
      {site.cnpj && <p class="tabular text-sm text-sup-suave">CNPJ {site.cnpj}</p>}
      {DEV && !site.cnpj && <Pendente texto="CNPJ" campo="cnpj" forma="linha" />}
    </div>

    <nav aria-label="Rodapé" class="lg:col-span-3">
      <h2 class="rodape__titulo">Páginas</h2>
      <ul class="mt-3 flex flex-col">
        {
          paginas.map((p) => (
            <li>
              <a class="rodape__link" href={p.href} aria-current={atual(p.href, caminho)}>
                {p.rotulo}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="lg:col-span-4">
      <h2 class="rodape__titulo">Atendimento</h2>
      <ul class="mt-3 flex flex-col">
        <li>
          <a class="rodape__link" href={portal.url} target="_blank" rel="noopener">
            {portal.nome}
            <Icone nome="externo" class="size-4" />
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
        </li>
        {
          whatsapp && (
            <li>
              <a class="rodape__link" href={whatsapp} target="_blank" rel="noopener">
                WhatsApp <span class="tabular">{site.whatsapp}</span>
                <span class="sr-only"> (abre em nova aba)</span>
              </a>
            </li>
          )
        }
        {
          telefone && (
            <li>
              <a class="rodape__link" href={telefone}>
                Telefone <span class="tabular">{site.telefone}</span>
              </a>
            </li>
          )
        }
        <li>
          <a class="rodape__link" href={site.instagram} target="_blank" rel="noopener">
            Instagram
            <Icone nome="externo" class="size-4" />
            <span class="sr-only"> (abre em nova aba)</span>
          </a>
        </li>
      </ul>
    </div>
  </div>

  <div class="border-t border-sup-linha">
    <p class:list={['mx-auto w-full max-w-pagina px-calha pt-6 text-sm text-sup-suave', whatsapp ? 'pb-28 md:pb-6' : 'pb-6']}>
      © {ano} {site.nome}
    </p>
  </div>
</footer>

<style>
  @layer components {
    .rodape__logo {
      --logo-altura: 4.25rem;
    }

    @media (width >= 48rem) {
      .rodape__logo {
        --logo-altura: 5rem;
      }
    }

    .rodape__titulo {
      color: var(--color-branco);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-bold);
      letter-spacing: var(--tracking-rotulo);
    }

    .rodape__link {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 3rem;
      color: var(--sup-texto);
      text-decoration: underline;
      text-decoration-color: transparent;
    }

    .rodape__link[aria-current='page'] {
      color: var(--color-branco);
      text-decoration-color: var(--color-amarelo);
    }

    @media (hover: hover) {
      .rodape__link:hover {
        color: var(--color-branco);
        text-decoration-color: var(--color-amarelo);
      }
    }
  }
</style>
