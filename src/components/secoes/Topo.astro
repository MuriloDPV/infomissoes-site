---
import Botao from '../ui/Botao.astro';
import Icone from '../ui/Icone.astro';
import Logo from '../ui/Logo.astro';
import { portal, whatsapp } from '../../lib/dados.ts';
import { atual, paginas } from '../../lib/navegacao.ts';

// Página aberta: o link dela fica marcado (aria-current="page", ou "true" nas páginas de dentro, como
// /planos/empresas/; estilo próprio no desktop e no menu).
const caminho = Astro.url.pathname;
---

<header data-topo class="topo">
  <div class="topo__barra">
    <div class="topo__interno mx-auto flex w-full max-w-pagina items-center justify-between gap-4 px-calha">
      <a href="/" class="topo__marca" data-logo-topo>
        <Logo animada class="topo__logo" />
        <span class="sr-only">, página inicial</span>
      </a>

      <nav aria-label="Principal" class="hidden lg:block">
        <ul class="flex items-center gap-1">
          {
            paginas.map((p) => (
              <li>
                <a class="topo__link" href={p.href} aria-current={atual(p.href, caminho)}>
                  {p.rotulo}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class="flex items-center gap-3">
        <Botao href={portal.url} externo variante="secundario" icone="usuario" class="hidden md:inline-flex">
          {portal.nome}
        </Botao>

        <details data-menu class="menu lg:hidden">
          <summary class="menu__botao">
            <Icone nome="menu" class="menu__icone menu__icone--abrir" />
            <Icone nome="fechar" class="menu__icone menu__icone--fechar" />
            <span>Menu</span>
          </summary>
          <div class="menu__painel sup-clara">
            <nav aria-label="Principal (menu)">
              <ul>
                {
                  paginas.map((p) => {
                    const marcada = atual(p.href, caminho);
                    return (
                      <li>
                        <a class="menu__link" href={p.href} aria-current={marcada}>
                          <span>{p.rotulo}</span>
                          {marcada ? (
                            <span class="menu__aqui" aria-hidden="true">
                              Você está aqui
                            </span>
                          ) : (
                            <Icone nome="seta" class="menu__seta" />
                          )}
                        </a>
                      </li>
                    );
                  })
                }
              </ul>
            </nav>
            <div class="menu__acoes">
              {
                whatsapp && (
                  <Botao href={whatsapp} externo indicador={false} icone="whatsapp" cheio>
                    Chamar no WhatsApp
                  </Botao>
                )
              }
              <Botao href={portal.url} externo variante="secundario" icone="usuario" cheio>
                {portal.nome}
              </Botao>
            </div>
          </div>
        </details>
      </div>
    </div>
  </div>

  <a href={portal.url} target="_blank" rel="noopener" class="topo__faixa md:hidden">
    <span class="topo__faixa-interno mx-auto flex w-full max-w-pagina items-center gap-3 px-calha">
      <Icone nome="usuario" class="topo__faixa-icone" />
      <strong class="topo__faixa-rotulo">{portal.nome}</strong>
      <span class="topo__faixa-apoio">2ª via, PIX e faturas</span>
      <Icone nome="externo" class="topo__faixa-seta" />
      <span class="sr-only"> (abre em nova aba)</span>
    </span>
  </a>
</header>

<script is:inline>
  // Entrada da logo (só com html.intro, ligada no <head>). Copia a logo do cabeçalho, deixa o CSS
  // montar a cópia no centro e depois leva a cópia até o lugar da original (FLIP).
  // Toque, clique, tecla ou rolagem pulam direto para o fim. No fim não sobra nada por cima.
  (function () {
    var raiz = document.documentElement;
    if (!raiz.classList.contains('intro')) return;
    var marca = document.querySelector('[data-logo-topo] .logo__svg');
    var eventos = ['pointerdown', 'keydown', 'wheel', 'touchstart', 'scroll'];
    var timers = [];
    var caixa = null;
    var acabou = false;

    function terminar() {
      if (acabou) return;
      acabou = true;
      timers.forEach(clearTimeout);
      eventos.forEach(function (e) {
        window.removeEventListener(e, terminar, true);
      });
      if (caixa) caixa.remove();
      raiz.classList.remove('intro', 'intro-saindo');
    }

    function voar() {
      var fim = marca.getBoundingClientRect();
      var agora = caixa.getBoundingClientRect();
      if (!fim.width) return terminar();
      var dx = agora.left + agora.width / 2 - (fim.left + fim.width / 2);
      var dy = agora.top + agora.height / 2 - (fim.top + fim.height / 2);
      var escala = agora.width / fim.width;
      // Last: a cópia vai para o lugar final. Invert: transform que a deixa onde está agora.
      caixa.style.cssText =
        'top:' + fim.top + 'px;left:' + fim.left + 'px;width:' + fim.width + 'px;' +
        'transform:translate(' + dx + 'px,' + dy + 'px) scale(' + escala + ')';
      caixa.getBoundingClientRect();
      // Play
      caixa.classList.add('is-voando');
      caixa.style.transform = 'none';
      raiz.classList.add('intro-saindo');
      timers.push(setTimeout(terminar, 580));
    }

    try {
      caixa = document.createElement('div');
      caixa.className = 'intro-logo';
      caixa.setAttribute('aria-hidden', 'true');
      var copia = marca.cloneNode(true);
      var defs = copia.querySelector('defs');
      if (defs) defs.remove();
      copia.removeAttribute('role');
      copia.removeAttribute('aria-label');
      caixa.appendChild(copia);
      document.body.appendChild(caixa);
      eventos.forEach(function (e) {
        window.addEventListener(e, terminar, { capture: true, passive: true });
      });
      timers.push(setTimeout(voar, 1320));
      timers.push(setTimeout(terminar, 2000));
    } catch (erro) {
      terminar();
    }
  })();
</script>

<style>
  /* Estilos do componente ficam na camada components: utilitários do Tailwind vencem. */
  @layer components {
    .topo {
      position: sticky;
      top: 0;
      z-index: 30;
      isolation: isolate;
    }

    /* Sombra quando a página rola: só a opacidade anima */
    .topo::after {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      box-shadow: var(--shadow-topo);
      opacity: 0;
      pointer-events: none;
      transition: opacity var(--duracao-lenta) var(--ease-saida);
    }
    .topo.is-compacto::after {
      opacity: 1;
    }

    /* z-index: o painel do menu (dentro da barra) fica por cima da faixa do portal */
    .topo__barra {
      position: relative;
      z-index: 1;
      background-color: var(--color-branco);
      box-shadow: inset 0 -1px 0 var(--color-marinho-100);
    }

    /* Logo em destaque (pedido de 29/10/2026): grande no topo da página e menor quando a página rola
       (.is-compacto, ligado pelo Base.astro). A entrada da logo mede o lugar final na hora, então pousa
       no tamanho grande. */
    .topo__interno {
      height: 5.5rem;
      transition: height var(--duracao-lenta) var(--ease-saida);
    }

    .topo__marca {
      display: inline-flex;
      align-items: center;
      min-height: 3rem;
      border-radius: var(--radius-sm);
      text-decoration: none;
      --logo-altura: 4.25rem;
    }
    .topo__marca :global(.logo) {
      transition: height var(--duracao-lenta) var(--ease-saida);
    }

    .topo.is-compacto .topo__interno {
      height: 4.25rem;
    }
    .topo.is-compacto .topo__marca {
      --logo-altura: 2.875rem;
    }

    @media (width >= 48rem) {
      .topo__interno {
        height: 8rem;
      }
      .topo__marca {
        --logo-altura: 6.75rem;
      }
      .topo.is-compacto .topo__interno {
        height: 5.25rem;
      }
      .topo.is-compacto .topo__marca {
        --logo-altura: 3.75rem;
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .topo__interno,
      .topo__marca :global(.logo) {
        transition: none;
      }
    }

    /* Links do menu no desktop: sublinhado amarelo que cresce da esquerda */
    .topo__link {
      position: relative;
      display: inline-flex;
      align-items: center;
      min-height: 3rem;
      padding: 0 0.875rem;
      border-radius: var(--radius-sm);
      color: var(--color-marinho);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-semibold);
      text-decoration: none;
    }
    .topo__link::after {
      content: '';
      position: absolute;
      left: 0.875rem;
      right: 0.875rem;
      bottom: 0.625rem;
      height: 2px;
      border-radius: var(--radius-full);
      background-color: var(--color-amarelo);
      transform: scaleX(0);
      transform-origin: 0 50%;
      transition: transform var(--duracao-lenta) var(--ease-saida);
    }
    @media (hover: hover) {
      .topo__link:hover::after {
        transform: scaleX(1);
      }
    }

    /* Página aberta: sublinhado fixo em marinho, mais grosso que o do hover (o peso do texto
       não muda, para os links não andarem ao trocar de página) */
    .topo__link[aria-current]::after {
      height: 3px;
      background-color: var(--color-marinho);
      transform: scaleX(1);
    }

    /* Faixa do portal (celular): sempre visível junto do cabeçalho */
    .topo__faixa {
      position: relative;
      isolation: isolate;
      display: block;
      background-color: var(--color-marinho);
      color: var(--color-branco);
      text-decoration: none;
      --sup-foco: var(--color-amarelo);
      container-type: inline-size;
    }
    .topo__faixa::before {
      content: '';
      position: absolute;
      inset: 0;
      z-index: -1;
      background-color: var(--color-marinho-800);
      opacity: 0;
      transition: opacity var(--duracao-base) var(--ease-saida);
    }
    .topo__faixa:active::before {
      opacity: 1;
    }
    .topo__faixa:focus-visible {
      outline-offset: -4px;
    }
    .topo__faixa-interno {
      min-height: 2.75rem;
    }
    .topo__faixa-icone {
      width: 1.25rem;
      height: 1.25rem;
      flex: none;
      color: var(--color-amarelo);
    }
    .topo__faixa-rotulo {
      font-size: var(--text-sm);
      font-weight: var(--font-weight-bold);
      white-space: nowrap;
    }
    .topo__faixa-apoio {
      display: none;
      min-width: 0;
      overflow: hidden;
      color: var(--color-marinho-200);
      font-size: var(--text-sm);
      white-space: nowrap;
      text-overflow: ellipsis;
    }
    .topo__faixa-seta {
      width: 1.25rem;
      height: 1.25rem;
      margin-left: auto;
      flex: none;
    }
    @container (width >= 25.5rem) {
      .topo__faixa-apoio {
        display: inline;
      }
      .topo__faixa-apoio::before {
        content: '·';
        margin-right: 0.75rem;
      }
    }

    /* Menu (details/summary funciona sem JS) */
    .menu__botao {
      display: inline-flex;
      align-items: center;
      gap: 0.5rem;
      min-height: 3rem;
      padding: 0 1rem 0 0.875rem;
      border-radius: var(--radius-md);
      color: var(--color-marinho);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-bold);
      list-style: none;
      cursor: pointer;
      box-shadow: inset 0 0 0 1.5px var(--color-marinho-200);
      user-select: none;
      transition: transform var(--duracao-rapida) var(--ease-saida);
    }
    .menu__botao::-webkit-details-marker {
      display: none;
    }
    .menu__botao:active {
      transform: scale(0.97);
    }
    .menu__icone {
      width: 1.375rem;
      height: 1.375rem;
    }
    .menu__icone--fechar,
    .menu[open] .menu__icone--abrir {
      display: none;
    }
    .menu[open] .menu__icone--fechar {
      display: block;
    }
    .menu[open] .menu__botao {
      background-color: var(--color-fundo);
    }

    .menu__painel {
      position: absolute;
      top: 100%;
      left: 0;
      right: 0;
      padding: 0.5rem var(--spacing-calha) 1.5rem;
      border-radius: 0 0 var(--radius-2xl) var(--radius-2xl);
      box-shadow: var(--shadow-lg);
    }
    .menu[open] .menu__painel {
      animation: menu-entra var(--duracao-lenta) var(--ease-saida);
    }
    @media (width >= 48rem) {
      .menu__painel {
        left: auto;
        right: var(--spacing-calha);
        width: 22rem;
        margin-top: 0.5rem;
        border-radius: var(--radius-2xl);
      }
    }

    .menu__link {
      display: flex;
      align-items: center;
      justify-content: space-between;
      min-height: var(--spacing-toque-lg);
      border-bottom: 1px solid var(--color-marinho-100);
      color: var(--color-marinho);
      font-size: var(--text-lg);
      font-weight: var(--font-weight-bold);
      text-decoration: none;
    }
    .menu__seta {
      width: 1.25rem;
      height: 1.25rem;
      color: var(--color-azul);
    }

    /* Página aberta no menu do celular: traço amarelo à esquerda e "Você está aqui" no lugar da seta */
    .menu__link[aria-current] {
      position: relative;
      padding-left: 1rem;
      font-weight: var(--font-weight-extrabold);
    }
    .menu__link[aria-current]::before {
      content: '';
      position: absolute;
      left: 0;
      top: 1rem;
      bottom: 1rem;
      width: 4px;
      border-radius: var(--radius-full);
      background-color: var(--color-amarelo);
    }
    .menu__aqui {
      color: var(--color-marinho-600);
      font-size: var(--text-sm);
      font-weight: var(--font-weight-semibold);
    }
    .menu__acoes {
      display: flex;
      flex-direction: column;
      gap: 0.75rem;
      margin-top: 1.25rem;
    }

    @keyframes menu-entra {
      from {
        opacity: 0;
        transform: translate3d(0, -0.5rem, 0);
      }
    }

    @media (prefers-reduced-motion: reduce) {
      .topo::after,
      .topo__link::after {
        transition: none;
      }
      .menu[open] .menu__painel {
        animation-name: menu-aparece;
      }
      @keyframes menu-aparece {
        from {
          opacity: 0;
        }
      }
    }
  }
</style>
