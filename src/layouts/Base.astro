---
import '../styles/global.css';
// Montserrat empacotada no site (só o subconjunto latino, que cobre o português).
import fonteMontserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import { getImage } from 'astro:assets';
import { site } from '../data/site.ts';
import { favicon, imagemFoto } from '../lib/dados.ts';

interface Props {
  titulo: string;
  descricao: string;
}

const { titulo, descricao } = Astro.props;
const canonica = new URL(Astro.url.pathname, site.url).href;

// Imagem de compartilhamento: usa a foto do destaque quando existir.
const fotoDestaque = imagemFoto(site.fotos.destaque, 'fotos.destaque');
const imagemOg = fotoDestaque
  ? new URL((await getImage({ src: fotoDestaque, width: 1200, height: 630, format: 'jpg' })).src, site.url).href
  : null;

const fontes = `
@font-face{font-family:"Montserrat Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${fonteMontserrat}) format("woff2-variations"),url(${fonteMontserrat}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Montserrat Reserva";src:local("Arial");size-adjust:113.39%;ascent-override:85.37%;descent-override:22.14%;line-gap-override:0%}
`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    <link rel="canonical" href={canonica} />
    <meta name="theme-color" content="#1a2d6d" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    <meta property="og:url" content={canonica} />
    {imagemOg && <meta property="og:image" content={imagemOg} />}
    {imagemOg && <meta property="og:image:width" content="1200" />}
    {imagemOg && <meta property="og:image:height" content="630" />}
    {imagemOg && <meta name="twitter:card" content="summary_large_image" />}

    {favicon ? <link rel="icon" href={favicon} /> : <link rel="icon" href="data:," />}

    <link rel="preload" href={fonteMontserrat} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontes} />

    <script is:inline>
      // Script mínimo: entrada ao rolar, cabeçalho compacto, botão flutuante e menu.
      // Sem IntersectionObserver ou com erro, nada fica escondido.
      (function () {
        var raiz = document.documentElement;
        if (!('IntersectionObserver' in window)) return;
        raiz.classList.add('js');

        function observar(alvo, aoMudar, opcoes) {
          if (!alvo) return;
          new IntersectionObserver(function (entradas) {
            aoMudar(entradas[0].isIntersecting);
          }, opcoes).observe(alvo);
        }

        function iniciar() {
          try {
            var revelar = new IntersectionObserver(
              function (entradas) {
                entradas.forEach(function (e) {
                  if (!e.isIntersecting) return;
                  e.target.classList.add('is-visivel');
                  revelar.unobserve(e.target);
                });
              },
              { rootMargin: '0px 0px -6% 0px' }
            );
            document.querySelectorAll('[data-revelar]').forEach(function (el) {
              revelar.observe(el);
            });

            var topo = document.querySelector('[data-topo]');
            observar(document.querySelector('[data-sentinela]'), function (visivel) {
              if (topo) topo.classList.toggle('is-compacto', !visivel);
            });

            var destaque = document.querySelector('[data-destaque]');
            observar(destaque, function (visivel) {
              destaque.classList.toggle('is-pausado', !visivel);
            });

            var flutuante = document.querySelector('[data-whatsapp-flutuante]');
            var cta = document.querySelector('[data-cta-whatsapp]');
            if (flutuante) {
              if (cta) {
                observar(cta, function (visivel) {
                  flutuante.classList.toggle('is-visivel', !visivel);
                });
              } else {
                flutuante.classList.add('is-visivel');
              }
            }

            var menu = document.querySelector('[data-menu]');
            if (menu) {
              menu.addEventListener('click', function (e) {
                if (e.target.closest('a')) menu.open = false;
              });
              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && menu.open) {
                  menu.open = false;
                  menu.querySelector('summary').focus();
                }
              });
              document.addEventListener('click', function (e) {
                if (menu.open && !menu.contains(e.target)) menu.open = false;
              });
            }
          } catch (erro) {
            raiz.classList.remove('js');
          }
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
        else iniciar();
      })();
    </script>
  </head>
  <body class="relative">
    <div data-sentinela aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-6 w-px"></div>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-amarelo focus:px-4 focus:py-3 focus:font-bold focus:text-azul"
      >Pular para o conteúdo</a
    >
    <slot />
  </body>
</html>
