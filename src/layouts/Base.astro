---
import '../styles/global.css';
// Montserrat empacotada no site (só o subconjunto latino, que cobre o português).
import fonteMontserrat from '@fontsource-variable/montserrat/files/montserrat-latin-wght-normal.woff2?url';
import Topo from '../components/secoes/Topo.astro';
import Rodape from '../components/secoes/Rodape.astro';
import WhatsAppFlutuante from '../components/ui/WhatsAppFlutuante.astro';
import { site } from '../data/site.ts';
import { favicon, icones, imagemCompartilhar } from '../lib/dados.ts';

// Molde de todas as páginas: <head>, cabeçalho, <main> com o conteúdo da página, rodapé e WhatsApp flutuante.
interface Props {
  titulo: string;
  descricao: string;
  /** false na 404: noindex, sem canonical e sem og:url. */
  indexar?: boolean;
}

const { titulo, descricao, indexar = true } = Astro.props;
const canonica = indexar ? new URL(Astro.url.pathname, site.url).href : null;

// Imagem de compartilhamento (1200x630, com a logo), gerada por scripts/marca/gerar-icones.mjs.
const imagemOg = imagemCompartilhar ? new URL(imagemCompartilhar, site.url).href : null;

const fontes = `
@font-face{font-family:"Montserrat Variable";font-style:normal;font-display:swap;font-weight:100 900;src:url(${fonteMontserrat}) format("woff2-variations"),url(${fonteMontserrat}) format("woff2");unicode-range:U+0000-00FF,U+0131,U+0152-0153,U+02BB-02BC,U+02C6,U+02DA,U+02DC,U+0304,U+0308,U+0329,U+2000-206F,U+20AC,U+2122,U+2191,U+2193,U+2212,U+2215,U+FEFF,U+FFFD}
@font-face{font-family:"Montserrat Reserva";src:local("Arial");size-adjust:113.39%;ascent-override:85.37%;descent-override:22.14%;line-gap-override:0%}
`;
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{titulo}</title>
    <meta name="description" content={descricao} />
    {canonica ? <link rel="canonical" href={canonica} /> : <meta name="robots" content="noindex" />}
    <meta name="theme-color" content="#ffffff" />
    <meta name="format-detection" content="telephone=no" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content={site.nome} />
    <meta property="og:title" content={titulo} />
    <meta property="og:description" content={descricao} />
    {canonica && <meta property="og:url" content={canonica} />}
    {imagemOg && <meta property="og:image" content={imagemOg} />}
    {imagemOg && <meta property="og:image:alt" content={`Logo da ${site.nome}`} />}
    {imagemOg && <meta property="og:image:width" content="1200" />}
    {imagemOg && <meta property="og:image:height" content="630" />}
    {imagemOg && <meta name="twitter:card" content="summary_large_image" />}

    {/* O .ico vem antes e com sizes="32x32" para o navegador que entende SVG escolher o SVG. */}
    {icones.ico && <link rel="icon" href={icones.ico} sizes="32x32" />}
    {favicon ? <link rel="icon" href={favicon} type={favicon.endsWith('.svg') ? 'image/svg+xml' : undefined} /> : <link rel="icon" href="data:," />}
    {icones.celular && <link rel="apple-touch-icon" href={icones.celular} />}
    {icones.manifesto && <link rel="manifest" href={icones.manifesto} />}

    <link rel="preload" href={fonteMontserrat} as="font" type="font/woff2" crossorigin />
    <style is:inline set:html={fontes} />

    <script is:inline>
      // Script mínimo: entrada da logo, entrada ao rolar, sombra do cabeçalho, botão flutuante e menu.
      // A troca de página não usa JS (View Transitions nativas, em global.css).
      // Sem IntersectionObserver ou com erro, nada fica escondido.
      (function () {
        var raiz = document.documentElement;

        // Entrada da logo: só na primeira visita da sessão, com sessionStorage funcionando
        // e sem movimento reduzido. Quem anima é o script logo depois do cabeçalho.
        try {
          if (
            window.matchMedia('(prefers-reduced-motion: no-preference)').matches &&
            !window.sessionStorage.getItem('infomissoes-intro')
          ) {
            window.sessionStorage.setItem('infomissoes-intro', '1');
            raiz.classList.add('intro');
            setTimeout(function () {
              raiz.classList.remove('intro', 'intro-saindo');
            }, 2600);
          }
        } catch (erro) {
          raiz.classList.remove('intro');
        }

        if (!('IntersectionObserver' in window)) return;
        raiz.classList.add('js');

        function observar(alvo, aoMudar, opcoes) {
          if (!alvo) return;
          new IntersectionObserver(function (entradas) {
            aoMudar(entradas[0].isIntersecting);
          }, opcoes).observe(alvo);
        }

        function iniciar() {
          try {
            var revelar = new IntersectionObserver(
              function (entradas) {
                entradas.forEach(function (e) {
                  if (!e.isIntersecting) return;
                  e.target.classList.add('is-visivel');
                  revelar.unobserve(e.target);
                });
              },
              { rootMargin: '0px 0px -6% 0px' }
            );
            document.querySelectorAll('[data-revelar]').forEach(function (el) {
              revelar.observe(el);
            });

            var topo = document.querySelector('[data-topo]');
            observar(document.querySelector('[data-sentinela]'), function (visivel) {
              if (topo) topo.classList.toggle('is-compacto', !visivel);
            });

            // Animações de fundo param fora da tela
            document.querySelectorAll('[data-destaque], [data-pausavel], .logo--animada').forEach(function (el) {
              observar(el, function (visivel) {
                el.classList.toggle('is-pausado', !visivel);
              });
            });

            // Botão flutuante: some enquanto algum botão grande de WhatsApp da página está na tela.
            var flutuante = document.querySelector('[data-whatsapp-flutuante]');
            var ctas = document.querySelectorAll('[data-cta-whatsapp]');
            if (flutuante) {
              if (ctas.length) {
                var naTela = new Set();
                var observarCtas = new IntersectionObserver(function (entradas) {
                  entradas.forEach(function (e) {
                    if (e.isIntersecting) naTela.add(e.target);
                    else naTela.delete(e.target);
                  });
                  flutuante.classList.toggle('is-visivel', naTela.size === 0);
                });
                ctas.forEach(function (c) {
                  observarCtas.observe(c);
                });
              } else {
                flutuante.classList.add('is-visivel');
              }
            }

            var menu = document.querySelector('[data-menu]');
            if (menu) {
              menu.addEventListener('click', function (e) {
                if (e.target.closest('a')) menu.open = false;
              });
              document.addEventListener('keydown', function (e) {
                if (e.key === 'Escape' && menu.open) {
                  menu.open = false;
                  menu.querySelector('summary').focus();
                }
              });
              document.addEventListener('click', function (e) {
                if (menu.open && !menu.contains(e.target)) menu.open = false;
              });
              // Voltar para uma página guardada pelo navegador (botão Voltar): menu fechado.
              window.addEventListener('pageshow', function (e) {
                if (e.persisted) menu.open = false;
              });
            }
          } catch (erro) {
            raiz.classList.remove('js');
          }
        }

        if (document.readyState === 'loading') document.addEventListener('DOMContentLoaded', iniciar);
        else iniciar();
      })();
    </script>
  </head>
  <body class="relative">
    <div data-sentinela aria-hidden="true" class="pointer-events-none absolute top-0 left-0 h-6 w-px"></div>
    <a
      href="#conteudo"
      class="sr-only focus:not-sr-only focus:fixed focus:top-3 focus:left-3 focus:z-50 focus:rounded-md focus:bg-amarelo focus:px-4 focus:py-3 focus:font-bold focus:text-marinho"
      >Pular para o conteúdo</a
    >
    <Topo />
    <main id="conteudo">
      <slot />
    </main>
    <Rodape />
    <WhatsAppFlutuante />
  </body>
</html>
