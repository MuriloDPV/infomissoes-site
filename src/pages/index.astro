---
// Início (ordem pedida pelo Murilo em 29/10/2026): destaque, cidades atendidas logo no começo, resumo dos
// planos para casa, contato (atendimento e plantão), "Já é cliente?", soluções para cada perfil e diferenciais.
// A chamada final saiu: o contato já faz esse papel.
import Base from '../layouts/Base.astro';
import Destaque from '../components/secoes/Destaque.astro';
import JaECliente from '../components/secoes/JaECliente.astro';
import Solucoes from '../components/secoes/Solucoes.astro';
import Planos from '../components/secoes/Planos.astro';
import CidadesInicio from '../components/secoes/CidadesInicio.astro';
import Contato from '../components/secoes/Contato.astro';
import Diferenciais from '../components/secoes/Diferenciais.astro';
import { portal, whatsapp } from '../lib/dados.ts';

const titulo = 'Info Missões | Internet de fibra óptica nas Missões';
const descricao = `Internet de fibra óptica na região das Missões (RS), para casa e empresa, e internet via rádio no interior. ${
  whatsapp ? 'Fale com a gente pelo WhatsApp' : 'Fale com a gente'
} ou acesse ${portal.a} para 2ª via, PIX e faturas.`;
---

<Base titulo={titulo} descricao={descricao}>
  <Destaque />
  <CidadesInicio />
  <Planos resumo />
  <Contato inicio />
  <JaECliente />
  <Solucoes />
  <Diferenciais />
</Base>
