---
// /planos/interior/ (Interior): a mesma abertura escura com o seletor, o plano rural e, ao lado, um texto curto
// sobre consultar se o sinal chega na localidade e as condições. É VIA RÁDIO: nada nesta página fala em fibra.
import Base from '../../layouts/Base.astro';
import AberturaEscura from '../../components/secoes/AberturaEscura.astro';
import Planos from '../../components/secoes/Planos.astro';
import SeletorPlanos from '../../components/ui/SeletorPlanos.astro';
import { porExtenso, SOB_CONSULTA } from '../../lib/contato.ts';
import { whatsapp } from '../../lib/dados.ts';
import { categoria, planosDa } from '../../lib/planos.ts';

const { tecnologia } = categoria('interior');
const planos = planosDa('interior');
const canal = whatsapp ? 'pelo WhatsApp' : 'com a gente';
const titulo = 'Internet via rádio no interior | Info Missões';
const lista = porExtenso(
  planos.map(
    (p) =>
      `${p.nome}, com ${p.download} de download e ${p.upload} de upload (${
        p.preco === SOB_CONSULTA ? 'preço sob consulta' : `${p.preco} por mês`
      })`
  )
);
const descricao = planos.length
  ? `${tecnologia} para quem mora no interior, na região das Missões (RS): ${
      planos.length > 1 ? 'planos' : 'plano'
    } ${lista}. Consulte ${canal} se chega na sua localidade.`
  : `${tecnologia} para quem mora no interior, na região das Missões (RS). Consulte ${canal} se chega na sua localidade.`;
---

<Base titulo={titulo} descricao={descricao}>
  <AberturaEscura titulo="Planos de internet" texto={`${tecnologia} para quem mora no interior da região.`}>
    <SeletorPlanos atual="interior" />
  </AberturaEscura>
  <Planos
    categoria="interior"
    texto={`Como é via rádio, o sinal depende da sua localidade. Consulte ${canal} se ele chega até você.`}
  />
</Base>
